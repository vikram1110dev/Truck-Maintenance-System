@model Truck_Maintanance_system.Models.TyreInventory

@{
    ViewData["Title"] = "Delete Tyre";
}

<div class="container mt-4 mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card shadow border-danger">
                <div class="card-header bg-danger text-white py-3">
                    <h5 class="m-0 font-weight-bold"><i class="fas fa-exclamation-triangle mr-2"></i> Confirm Delete Tyre</h5>
                </div>
                <div class="card-body p-4">
                    <p class="text-muted">Are you sure you want to remove this tyre record from the inventory system?</p>

                    <dl class="row mb-4">
                        <dt class="col-sm-4 text-muted">Serial No</dt>
                        <dd class="col-sm-8 font-weight-bold">@Model.SerialNumber</dd>

                        <dt class="col-sm-4 text-muted">Brand & Size</dt>
                        <dd class="col-sm-8">@Model.Brand (@Model.Size)</dd>

                        <dt class="col-sm-4 text-muted">Truck</dt>
                        <dd class="col-sm-8">@(Model.Truck?.LicensePlate ?? "Unassigned")</dd>

                        <dt class="col-sm-4 text-muted">Position</dt>
                        <dd class="col-sm-8">@Model.AxlePosition</dd>
                    </dl>

                    <form asp-action="Delete" method="post">
                        <input type="hidden" asp-for="Id" />
                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">Cancel</a>
                            <button type="submit" class="btn btn-danger rounded-pill px-4">
                                <i class="fas fa-trash mr-1"></i> Delete Tyre
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
