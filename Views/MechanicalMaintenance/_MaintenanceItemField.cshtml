@model (string PropertyName, string InputType)
@{
    var propertyName = Model.PropertyName;
    var displayAttribute = ViewData.ModelMetadata.Properties[propertyName]?.DisplayName ?? propertyName;
    var inputType = Model.InputType;
}

<div class="row mb-3 align-items-center border-bottom pb-2 maintenance-item-group">
    <div class="col-md-2 fw-bold text-truncate" title="@displayAttribute">
        @displayAttribute
    </div>
    <div class="col-md-3">
        <label class="form-label small text-muted mb-1">Status/Action</label>
        
        @if (inputType == "Oil")
        {
            <select name="@(propertyName).Status" class="form-select form-select-sm" required>
                <option value="">-- Select --</option>
                <option value="Checked">Checked</option>
                <option value="Top-up">Top-up</option>
                <option value="Changed">Changed</option>
            </select>
        }
        else if (inputType == "Filter")
        {
            <select name="@(propertyName).Status" class="form-select form-select-sm" required>
                <option value="">-- Select --</option>
                <option value="Checked">Checked</option>
                <option value="Cleaned">Cleaned</option>
                <option value="Changed">Changed</option>
            </select>
        }
        else if (inputType == "Brake")
        {
            <select name="@(propertyName).Status" class="form-select form-select-sm" required>
                <option value="">-- Select --</option>
                <option value="Checked">Checked</option>
                <option value="Replaced">Replaced</option>
            </select>
        }
        else if (inputType == "Percentage")
        {
            <select name="@(propertyName).Status" class="form-select form-select-sm" required>
                <option value="">-- Select --</option>
                <option value="100%">100% (New)</option>
                <option value="90%">90%</option>
                <option value="80%">80%</option>
                <option value="75%">75% (Good)</option>
                <option value="60%">60%</option>
                <option value="50%">50% (Fair)</option>
                <option value="40%">40%</option>
                <option value="30%">30%</option>
                <option value="25%">25% (Poor)</option>
                <option value="20%">20%</option>
                <option value="10%">10% (Critical)</option>
                <option value="0%">0% (Replace)</option>
            </select>
        }
        else if (inputType == "Alignment")
        {
            <select name="@(propertyName).Status" class="form-select form-select-sm" required>
                <option value="">-- Select --</option>
                <option value="Aligned">Aligned / Good</option>
                <option value="Needs Alignment">Needs Alignment</option>
            </select>
        }
        else if (inputType == "Condition")
        {
            <select name="@(propertyName).Status" class="form-select form-select-sm" required>
                <option value="">-- Select --</option>
                <option value="Excellent">Excellent</option>
                <option value="Good">Good</option>
                <option value="Fair">Fair</option>
                <option value="Poor">Poor</option>
                <option value="Needs Replacement">Needs Replacement</option>
                <option value="Punctured">Punctured/Damaged</option>
            </select>
        }
        else if (inputType == "Pressure")
        {
            <select name="@(propertyName).Status" class="form-select form-select-sm" required>
                <option value="">-- Select --</option>
                <option value="Normal">Normal</option>
                <option value="Low">Low (Filled)</option>
                <option value="High">High (Adjusted)</option>
                <option value="Punctured">Punctured</option>
            </select>
        }
        else if (inputType == "Compressor")
        {
            <select name="@(propertyName).Status" class="form-select form-select-sm" required>
                <option value="">-- Select --</option>
                <option value="Checked">Checked</option>
                <option value="Repaired">Repaired</option>
                <option value="Replaced">Replaced</option>
            </select>
        }
        else if (inputType == "Done")
        {
            <select name="@(propertyName).Status" class="form-select form-select-sm" required>
                <option value="">-- Select --</option>
                <option value="Done">Done</option>
                <option value="Not Done">Not Done</option>
            </select>
        }
        else
        {
            <select name="@(propertyName).Status" class="form-select form-select-sm" required>
                <option value="">-- Select --</option>
                <option value="Checked">Checked</option>
                <option value="OK">OK</option>
                <option value="Needs Attention">Needs Attention</option>
            </select>
        }
    </div>
    <div class="col-md-2">
        <label class="form-label small text-muted mb-1">Expense (₹)</label>
        <div class="input-group input-group-sm">
            <span class="input-group-text">₹</span>
            <input name="@(propertyName).Cost" type="number" step="0.01" class="form-control" required />
            <div class="invalid-feedback">Required.</div>
        </div>
    </div>
    <div class="col-md-2">
        <label class="form-label small text-muted mb-1">Valid (km)</label>
        <div class="input-group input-group-sm">
            <input name="@(propertyName).ValidForNextKm" type="number" class="form-control valid-km-input" />
            <span class="input-group-text">km</span>
        </div>
    </div>
    <div class="col-md-3">
        <label class="form-label small text-muted mb-1">Valid (Date)</label>
        <input name="@(propertyName).ValidForNextDate" type="date" class="form-control form-control-sm valid-date-input" />
        <div class="invalid-feedback d-none date-km-error">Must provide Valid Km or Valid Date.</div>
    </div>
    
    <div class="col-12 mt-2">
        <div class="input-group input-group-sm shadow-sm">
            <span class="input-group-text bg-light border-0"><i class="fas fa-sticky-note text-muted"></i></span>
            <input name="@(propertyName).Notes" class="form-control border-light bg-light" placeholder="Notes (Optional: e.g. thread depth low, requires follow-up, brand used...)" />
        </div>
    </div>
</div>
