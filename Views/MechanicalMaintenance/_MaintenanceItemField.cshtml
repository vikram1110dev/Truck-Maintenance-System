@model (string PropertyName, string InputType)
@{
    var propertyName = Model.PropertyName;
    var displayAttribute = ViewData.ModelMetadata.Properties[propertyName]?.DisplayName ?? propertyName;
    var inputType = Model.InputType;
}

<div class="row mb-3 align-items-center border-bottom pb-2">
    <div class="col-md-3 fw-bold">
        @displayAttribute
    </div>
    <div class="col-md-3">
        <label class="form-label small text-muted mb-1">Status/Action</label>
        
        @if (inputType == "Oil")
        {
            <select name="@(propertyName).Status" class="form-select form-select-sm">
                <option value="">-- Select --</option>
                <option value="Checked">Checked</option>
                <option value="Top-up">Top-up</option>
                <option value="Changed">Changed</option>
            </select>
        }
        else if (inputType == "Filter")
        {
            <select name="@(propertyName).Status" class="form-select form-select-sm">
                <option value="">-- Select --</option>
                <option value="Checked">Checked</option>
                <option value="Cleaned">Cleaned</option>
                <option value="Changed">Changed</option>
            </select>
        }
        else if (inputType == "Brake")
        {
            <select name="@(propertyName).Status" class="form-select form-select-sm">
                <option value="">-- Select --</option>
                <option value="Checked">Checked</option>
                <option value="Replaced">Replaced</option>
            </select>
        }
        else if (inputType == "Percentage")
        {
            <div class="input-group input-group-sm">
                <input name="@(propertyName).Status" type="number" min="0" max="100" class="form-control form-control-sm" placeholder="e.g. 80" />
                <span class="input-group-text">%</span>
            </div>
        }
        else
        {
            <input name="@(propertyName).Status" class="form-control form-control-sm" placeholder="e.g. Checked / OK" />
        }
    </div>
    <div class="col-md-3">
        <label class="form-label small text-muted mb-1">Valid for (km)</label>
        <div class="input-group input-group-sm">
            <input name="@(propertyName).ValidForNextKm" type="number" class="form-control" />
            <span class="input-group-text">km</span>
        </div>
    </div>
    <div class="col-md-3">
        <label class="form-label small text-muted mb-1">Valid to (Date)</label>
        <input name="@(propertyName).ValidForNextDate" type="date" class="form-control form-control-sm" />
    </div>
</div>
