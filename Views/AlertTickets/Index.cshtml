@model IEnumerable<Truck_Maintanance_system.Models.AlertTicket>

@{
    ViewData["Title"] = "Driver Alerts";
}

<div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0 text-gray-800">
            <i class="fas fa-exclamation-circle text-danger mr-2"></i> Driver Alerts & Support
        </h1>
        <a asp-action="Create" class="btn btn-danger shadow-sm">
            <i class="fas fa-plus fa-sm text-white-50 mr-2"></i> New Alert Ticket
        </a>
    </div>

    <div class="row">
        @if (!Model.Any())
        {
            <div class="col-12 text-center py-5">
                <i class="fas fa-check-circle fa-4x text-success mb-3"></i>
                <h4 class="text-gray-500">All Clear!</h4>
                <p class="text-muted">No active alerts or breakdowns reported.</p>
            </div>
        }
        
        @foreach (var ticket in Model)
        {
            var borderClass = ticket.Status == "Open" ? "border-left-danger border-danger" 
                            : (ticket.Status == "In Progress" ? "border-left-warning border-warning" : "border-left-success border-success");
            var iconClass = ticket.Category == "Truck Breakdown" ? "fa-tools" : "fa-info-circle";
            
            <div class="col-xl-4 col-md-6 mb-4">
                <a asp-action="Details" asp-route-id="@ticket.Id" class="text-decoration-none">
                    <div class="card shadow-sm h-100 py-2 @borderClass alert-card-hover">
                        <div class="card-body">
                            <div class="row no-gutters align-items-center">
                                <div class="col mr-2">
                                    <div class="text-xs font-weight-bold text-uppercase mb-1 text-primary">
                                        @ticket.Category - Truck @ticket.Truck?.LicensePlate
                                    </div>
                                    <div class="h5 mb-1 font-weight-bold text-gray-800 text-truncate">
                                        @ticket.Title
                                    </div>
                                    <div class="mt-2 small text-muted">
                                        <i class="far fa-clock"></i> Updated: @ticket.UpdatedAt.ToString("g")
                                    </div>
                                    <div class="mt-2">
                                        <span class="badge @(ticket.Status == "Open" ? "bg-danger" : (ticket.Status == "In Progress" ? "bg-warning text-dark" : "bg-success"))">
                                            @ticket.Status
                                        </span>
                                    </div>
                                </div>
                                <div class="col-auto">
                                    <i class="fas @iconClass fa-2x text-gray-300"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </a>
            </div>
        }
    </div>
</div>

<style>
    .alert-card-hover:hover {
        transform: translateY(-3px);
        transition: transform 0.2s ease-in-out;
        box-shadow: 0 .5rem 1rem rgba(0,0,0,.15)!important;
    }
</style>
