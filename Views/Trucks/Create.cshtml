@model Truck_Maintanance_system.Models.Truck

@{
    ViewData["Title"] = "Add New Truck";
}

<div class="container mt-4 mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 rounded-lg">
                <div class="card-header bg-primary text-white pt-4 pb-3">
                    <h5 class="m-0 font-weight-bold">
                        <i class="fas fa-truck mr-2"></i> Add New Truck
                    </h5>
                </div>
                <div class="card-body bg-light">
                    <form asp-action="Create" class="needs-validation">
                        
                        <div class="card shadow-sm border-0 mb-4">
                            <div class="card-body">
                                <h6 class="font-weight-bold text-primary border-bottom pb-2 mb-3">Vehicle Details</h6>
                                
                                <div class="mb-3">
                                    <label asp-for="LicensePlate" class="form-label font-weight-bold">License Plate</label>
                                    <input asp-for="LicensePlate" class="form-control text-uppercase" placeholder="e.g. TN-01-AB-1234" required />
                                    <span asp-validation-for="LicensePlate" class="text-danger"></span>
                                </div>

                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label asp-for="Make" class="form-label font-weight-bold">Make</label>
                                        <input asp-for="Make" class="form-control" placeholder="e.g. Tata, Ashok Leyland" required />
                                        <span asp-validation-for="Make" class="text-danger"></span>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label asp-for="Model" class="form-label font-weight-bold">Model</label>
                                        <input asp-for="Model" class="form-control" placeholder="e.g. Signa 4225.T" required />
                                        <span asp-validation-for="Model" class="text-danger"></span>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label asp-for="Year" class="form-label font-weight-bold">Year</label>
                                        <input asp-for="Year" type="number" class="form-control" placeholder="e.g. 2024" required />
                                        <span asp-validation-for="Year" class="text-danger"></span>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label asp-for="Vin" class="form-label font-weight-bold">VIN (Chassis Number)</label>
                                        <input asp-for="Vin" class="form-control text-uppercase" placeholder="Enter chassis number" required />
                                        <span asp-validation-for="Vin" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between pt-2">
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                            <button type="submit" class="btn btn-primary shadow-sm px-5 btn-lg">
                                <i class="fas fa-save mr-1"></i> Save Truck
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
