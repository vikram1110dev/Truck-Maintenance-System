@model Truck_Maintanance_system.Models.TruckTimelineViewModel

@{
    ViewData["Title"] = Model.Truck.LicensePlate + " Profile";
}

<style>
    /* Custom Timeline CSS */
    .timeline {
        position: relative;
        padding: 20px 0;
        list-style: none;
    }
    
    .timeline:before {
        content: '';
        position: absolute;
        top: 0;
        bottom: 0;
        left: 40px;
        width: 4px;
        background: #eaecf4;
        border-radius: 2px;
    }

    .timeline-item {
        position: relative;
        margin-bottom: 30px;
        padding-left: 90px;
    }

    .timeline-icon {
        position: absolute;
        left: 20px;
        top: 0;
        width: 44px;
        height: 44px;
        border-radius: 50%;
        text-align: center;
        line-height: 44px;
        color: #fff;
        background-color: #4e73df;
        box-shadow: 0 0.125rem 0.25rem 0 rgba(58, 59, 69, 0.2);
        z-index: 10;
        font-size: 1.2rem;
    }

    .timeline-card {
        background: #fff;
        border-radius: 0.35rem;
        box-shadow: 0 0.15rem 1.75rem 0 rgba(58, 59, 69, 0.15);
        padding: 15px;
        border-left: 4px solid #4e73df;
    }
    
    .timeline-date {
        font-size: 0.8rem;
        color: #858796;
        margin-bottom: 5px;
    }
</style>

<div class="container mt-4 mb-5">
    
    <!-- Truck Header Card -->
    <div class="card shadow mb-4 border-bottom-primary">
        <div class="card-body">
            <div class="row align-items-center">
                <div class="col-auto">
                    <i class="fas fa-truck-monster fa-4x text-gray-300"></i>
                </div>
                <div class="col">
                    <h2 class="font-weight-bold text-gray-800 mb-0">@Model.Truck.LicensePlate</h2>
                    <h5 class="text-muted">@Model.Truck.Make @Model.Truck.Model (@Model.Truck.Year)</h5>
                    <p class="mb-0 text-gray-500">VIN: @Model.Truck.Vin | <i class="fas fa-tachometer-alt ml-2 mr-1"></i> @Model.Truck.CurrentOdometer km</p>
                </div>
                <div class="col-auto text-right">
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="fas fa-arrow-left"></i> Back to Fleet</a>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Stats Row -->
    <div class="row mb-4">
        <div class="col-md-4 mb-3">
            <div class="card border-left-success shadow h-100 py-2">
                <div class="card-body py-1">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-success text-uppercase mb-1">Total Trips</div>
                            <div class="h4 mb-0 font-weight-bold text-gray-800">@Model.TotalTrips</div>
                        </div>
                        <div class="col-auto"><i class="fas fa-route fa-2x text-gray-300"></i></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card border-left-secondary shadow h-100 py-2">
                <div class="card-body py-1">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-secondary text-uppercase mb-1">Maintenance Logs</div>
                            <div class="h4 mb-0 font-weight-bold text-gray-800">@Model.TotalMaintenanceLogs</div>
                        </div>
                        <div class="col-auto"><i class="fas fa-tools fa-2x text-gray-300"></i></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card border-left-danger shadow h-100 py-2">
                <div class="card-body py-1">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-danger text-uppercase mb-1">Active Open Alerts</div>
                            <div class="h4 mb-0 font-weight-bold text-gray-800">@Model.OpenAlerts</div>
                        </div>
                        <div class="col-auto"><i class="fas fa-exclamation-triangle fa-2x text-gray-300"></i></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Master Timeline -->
    <h4 class="mb-3 text-gray-800 font-weight-bold"><i class="fas fa-history mr-2"></i> Master Timeline</h4>
    
    <div class="timeline">
        @if (!Model.Events.Any())
        {
            <div class="text-muted ml-5 pl-5 mt-4">
                <em>No history recorded for this truck yet. Log a trip, maintenance, or alert to see it here!</em>
            </div>
        }
        
        @foreach (var ev in Model.Events)
        {
            <!-- Map color class to icon background -->
            var bgClass = ev.ColorClass.Replace("border-left-", "bg-");
            
            <div class="timeline-item">
                <div class="timeline-icon @bgClass">
                    <i class="fas @ev.IconClass"></i>
                </div>
                <div class="timeline-card @ev.ColorClass">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <h6 class="font-weight-bold text-dark m-0">@ev.Title</h6>
                        <span class="badge badge-light text-muted border shadow-sm">@ev.EventType</span>
                    </div>
                    <div class="timeline-date"><i class="far fa-clock mr-1"></i> @ev.EventDate.ToString("f")</div>
                    <p class="mb-2 text-gray-800">@ev.Description</p>
                    
                    @if (!string.IsNullOrEmpty(ev.Url))
                    {
                        <a href="@ev.Url" class="btn btn-sm btn-outline-primary mt-1">View Details <i class="fas fa-chevron-right ml-1"></i></a>
                    }
                </div>
            </div>
        }
    </div>
</div>
