@model IEnumerable<Truck_Maintanance_system.Models.Truck>

@{
    ViewData["Title"] = "Fleet Profile";
}

<div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0 text-gray-800">
            <i class="fas fa-truck text-primary mr-2"></i> Fleet Profiles
        </h1>
        <a asp-controller="Trucks" asp-action="Create" class="btn btn-primary shadow-sm" style="display:none;">
            <!-- Keeping for future create form if needed, currently we assume DB is seeded or has another admin view -->
        </a>
    </div>

    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-xl-3 col-md-6 mb-4">
                <a asp-action="Details" asp-route-id="@item.Id" class="text-decoration-none">
                    <div class="card shadow-sm h-100 py-2 border-left-primary truck-card">
                        <div class="card-body">
                            <div class="row no-gutters align-items-center">
                                <div class="col mr-2">
                                    <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">
                                        @item.Make @item.Model (@item.Year)
                                    </div>
                                    <div class="h5 mb-0 font-weight-bold text-gray-800">
                                        @item.LicensePlate
                                    </div>
                                </div>
                                <div class="col-auto">
                                    <i class="fas fa-truck-moving fa-2x text-gray-300"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </a>
            </div>
        }
    </div>
</div>

<style>
    .truck-card:hover {
        transform: scale(1.02);
        transition: transform 0.2s ease-in-out;
    }
</style>
