@model IEnumerable<Truck_Maintanance_system.Models.Truck>

@{
    ViewData["Title"] = "Fleet Profile";
}

<div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0 text-gray-800">
            <i class="fas fa-truck text-primary mr-2"></i> Fleet Profiles
        </h1>
        <a asp-controller="Trucks" asp-action="Create" class="btn btn-primary shadow-sm">
            <i class="fas fa-plus fa-sm text-white-50 mr-2"></i> Add New Truck
        </a>
    </div>

    <!-- Search Bar -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body py-2">
            <form asp-action="Index" method="get" class="d-flex align-items-center">
                <div class="input-group">
                    <input type="text" name="search" value="@ViewBag.Search" class="form-control border-0 bg-light" placeholder="Search by plate, make, model, or VIN..." />
                    <div class="input-group-append">
                        <button class="btn btn-primary" type="submit">
                            <i class="fas fa-search"></i>
                        </button>
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(ViewBag.Search as string))
                {
                    <a asp-action="Index" class="btn btn-outline-secondary ml-2">
                        <i class="fas fa-times"></i> Clear
                    </a>
                }
            </form>
        </div>
    </div>

    @if (TempData["Warning"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-triangle mr-2"></i> @TempData["Warning"]
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }

    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-xl-3 col-md-6 mb-4">
                <div class="card shadow-sm h-100 py-2 border-left-primary truck-card">
                    <div class="card-body">
                        <a asp-action="Details" asp-route-id="@item.Id" class="text-decoration-none">
                            <div class="row no-gutters align-items-center">
                                <div class="col mr-2">
                                    <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">
                                        @item.Make @item.Model (@item.Year)
                                    </div>
                                    <div class="h5 mb-0 font-weight-bold text-gray-800">
                                        @item.LicensePlate
                                    </div>
                                    <div class="text-xs mt-1 text-gray-600">
                                        <i class="fas fa-tachometer-alt mr-1"></i> @item.CurrentOdometer.ToString("N0") km
                                    </div>
                                    <div class="mt-1">
                                        @{
                                            var statusColor = item.Status switch
                                            {
                                                Truck_Maintanance_system.Models.TruckStatus.Active => "success",
                                                Truck_Maintanance_system.Models.TruckStatus.InMaintenance => "warning",
                                                Truck_Maintanance_system.Models.TruckStatus.Inactive => "secondary",
                                                Truck_Maintanance_system.Models.TruckStatus.Retired => "danger",
                                                _ => "secondary"
                                            };
                                        }
                                        <span class="badge bg-@statusColor text-white" style="font-size: 0.65rem;">@item.Status</span>
                                    </div>
                                </div>
                                <div class="col-auto">
                                    <i class="fas fa-truck-moving fa-2x text-gray-300"></i>
                                </div>
                            </div>
                        </a>
                        <!-- Action Buttons -->
                        <div class="mt-3 pt-2 border-top d-flex justify-content-end">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning mr-2" title="Edit">
                                <i class="fas fa-edit"></i>
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" title="Delete">
                                <i class="fas fa-trash"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <i class="fas fa-truck fa-3x text-gray-300 mb-3"></i>
            <p class="text-muted">No trucks found. Add your first truck to get started!</p>
        </div>
    }
</div>

<style>
    .truck-card:hover {
        transform: scale(1.02);
        transition: transform 0.2s ease-in-out;
    }
</style>
