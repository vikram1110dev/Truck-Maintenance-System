@model Truck_Maintanance_system.Models.FuelLog

@{
    ViewData["Title"] = "Delete Fuel Log";
}

<div class="container mt-4 mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card shadow border-danger">
                <div class="card-header bg-danger text-white py-3">
                    <h5 class="m-0 font-weight-bold"><i class="fas fa-exclamation-triangle mr-2"></i> Confirm Delete Fuel Log</h5>
                </div>
                <div class="card-body p-4">
                    <p class="text-muted">Are you sure you want to delete this fuel record? This action cannot be undone.</p>
                    
                    <dl class="row mb-4">
                        <dt class="col-sm-4 text-muted">Truck</dt>
                        <dd class="col-sm-8 font-weight-bold">@Model.Truck?.LicensePlate</dd>

                        <dt class="col-sm-4 text-muted">Date</dt>
                        <dd class="col-sm-8">@Model.FuelDate.ToString("dd MMM yyyy")</dd>

                        <dt class="col-sm-4 text-muted">Driver</dt>
                        <dd class="col-sm-8">@Model.DriverName</dd>

                        <dt class="col-sm-4 text-muted">Quantity</dt>
                        <dd class="col-sm-8">@Model.Liters L</dd>

                        <dt class="col-sm-4 text-muted">Total Amount</dt>
                        <dd class="col-sm-8 text-danger font-weight-bold">₹@Model.TotalAmount.ToString("N2")</dd>
                    </dl>

                    <form asp-action="Delete" method="post">
                        <input type="hidden" asp-for="Id" />
                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">Cancel</a>
                            <button type="submit" class="btn btn-danger rounded-pill px-4">
                                <i class="fas fa-trash mr-1"></i> Delete Record
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
