@model IEnumerable<Truck_Maintanance_system.Models.SparePartUsage>

@{
    ViewData["Title"] = "Spare Parts Usage Audit History";
}

<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill mb-2">
                <i class="fas fa-arrow-left me-1"></i> Back to Inventory
            </a>
            <h2 class="font-weight-bold text-dark mb-0">
                <i class="fas fa-history text-info me-2"></i> Spare Parts Usage & Consumption Log
            </h2>
        </div>
        <div class="d-flex gap-2">
            <button onclick="window.print()" class="btn btn-outline-dark rounded-pill px-3 shadow-sm">
                <i class="fas fa-print me-1"></i> Print Log
            </button>
        </div>
    </div>

    <!-- Summary KPIs -->
    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <div class="card shadow-sm border-0 rounded-4 bg-light border-start border-4 border-primary p-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small text-uppercase font-weight-bold">Total Spare Part Units Issued</div>
                        <div class="h3 font-weight-bold text-dark mb-0">@ViewBag.TotalUnitsConsumed units</div>
                    </div>
                    <div class="rounded-circle bg-primary bg-opacity-10 p-3 text-primary">
                        <i class="fas fa-wrench fa-2x"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card shadow-sm border-0 rounded-4 bg-light border-start border-4 border-success p-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small text-uppercase font-weight-bold">Total Parts Expenditure</div>
                        <div class="h3 font-weight-bold text-success mb-0">₹@(((decimal)ViewBag.TotalSpentOnParts).ToString("N2"))</div>
                    </div>
                    <div class="rounded-circle bg-success bg-opacity-10 p-3 text-success">
                        <i class="fas fa-receipt fa-2x"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filter Bar -->
    <div class="card shadow-sm border-0 rounded-4 mb-4">
        <div class="card-body p-3">
            <form method="get" class="row g-2 align-items-center">
                <div class="col-md-5">
                    <select name="truckId" class="form-select" asp-items="ViewBag.TrucksList">
                        <option value="">-- All Trucks --</option>
                    </select>
                </div>
                <div class="col-md-5">
                    <select name="sparePartId" class="form-select" asp-items="ViewBag.PartsList">
                        <option value="">-- All Spare Parts --</option>
                    </select>
                </div>
                <div class="col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-dark w-100"><i class="fas fa-filter me-1"></i> Filter</button>
                    <a asp-action="UsageHistory" class="btn btn-outline-secondary"><i class="fas fa-undo"></i></a>
                </div>
            </form>
        </div>
    </div>

    <!-- Usage Table -->
    <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Date</th>
                        <th>Truck</th>
                        <th>Spare Part</th>
                        <th>Qty Used</th>
                        <th>Unit Price</th>
                        <th>Total Cost</th>
                        <th>Job Reference</th>
                        <th>Issued By</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                <i class="fas fa-clipboard-check fa-3x mb-3 text-secondary opacity-50"></i>
                                <p class="mb-0">No parts usage logs recorded yet.</p>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var u in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <i class="far fa-calendar-alt text-muted me-1"></i>
                                    @u.UsageDate.ToString("dd MMM yyyy")
                                </td>
                                <td>
                                    <strong><i class="fas fa-truck text-muted me-1"></i> @(u.Truck?.LicensePlate ?? "N/A")</strong>
                                    <div class="small text-muted">@(u.Truck?.Make) @(u.Truck?.Model)</div>
                                </td>
                                <td>
                                    <span class="font-weight-bold text-dark">@(u.SparePart?.PartName ?? "N/A")</span>
                                    <div class="small text-muted">SKU: @(u.SparePart?.PartNumber) | @(u.SparePart?.Category)</div>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border fs-6">@u.Quantity units</span>
                                </td>
                                <td>₹@u.UnitCost.ToString("N2")</td>
                                <td><strong class="text-success">₹@u.TotalCost.ToString("N2")</strong></td>
                                <td>@(string.IsNullOrEmpty(u.JobReference) ? "-" : u.JobReference)</td>
                                <td><small class="text-muted">@(string.IsNullOrEmpty(u.IssuedBy) ? "Workshop Staff" : u.IssuedBy)</small></td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
