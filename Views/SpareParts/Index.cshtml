@model IEnumerable<Truck_Maintanance_system.Models.SparePart>

@{
    ViewData["Title"] = "Workshop Spare Parts & Inventory";
}

<div class="container-fluid py-3">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="font-weight-bold text-dark mb-1">
                <i class="fas fa-boxes text-primary"></i> Spare Parts & Workshop Inventory
            </h2>
            <p class="text-muted mb-0">Manage mechanical spares, track inventory levels, monitor low stock reorders, and log part usage on trucks.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="UsageHistory" class="btn btn-outline-info shadow-sm rounded-pill px-3">
                <i class="fas fa-history me-1"></i> Parts Usage Log
            </a>
            <a asp-action="ExportCsv" class="btn btn-outline-success shadow-sm rounded-pill px-3">
                <i class="fas fa-file-excel me-1"></i> Export (CSV)
            </a>
            <a asp-action="Create" class="btn btn-primary shadow-sm rounded-pill px-4">
                <i class="fas fa-plus me-1"></i> Add New Spare Part
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm rounded-3" role="alert">
            <i class="fas fa-check-circle me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm rounded-3" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- KPI Summary Row -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card shadow-sm border-0 rounded-4 bg-light border-start border-4 border-primary p-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small text-uppercase font-weight-bold">Total SKUs in Inventory</div>
                        <div class="h3 font-weight-bold text-dark mb-0">@ViewBag.TotalPartsCount <span class="fs-6 text-muted">(@ViewBag.TotalStockUnits units)</span></div>
                    </div>
                    <div class="rounded-circle bg-primary bg-opacity-10 p-3 text-primary">
                        <i class="fas fa-cubes fa-2x"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm border-0 rounded-4 bg-light border-start border-4 border-success p-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small text-uppercase font-weight-bold">Total Inventory Valuation</div>
                        <div class="h3 font-weight-bold text-success mb-0">₹@(((decimal)ViewBag.TotalInventoryValue).ToString("N2"))</div>
                    </div>
                    <div class="rounded-circle bg-success bg-opacity-10 p-3 text-success">
                        <i class="fas fa-wallet fa-2x"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm border-0 rounded-4 bg-light border-start border-4 border-warning p-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small text-uppercase font-weight-bold">Low Stock Reorder Alerts</div>
                        <div class="h3 font-weight-bold text-warning mb-0">@ViewBag.LowStockCount</div>
                    </div>
                    <div class="rounded-circle bg-warning bg-opacity-10 p-3 text-warning">
                        <i class="fas fa-exclamation-circle fa-2x"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm border-0 rounded-4 bg-light border-start border-4 border-danger p-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small text-uppercase font-weight-bold">Out of Stock Items</div>
                        <div class="h3 font-weight-bold text-danger mb-0">@ViewBag.OutOfStockCount</div>
                    </div>
                    <div class="rounded-circle bg-danger bg-opacity-10 p-3 text-danger">
                        <i class="fas fa-ban fa-2x"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filter and Search -->
    <div class="card shadow-sm border-0 rounded-4 mb-4">
        <div class="card-body p-3">
            <form method="get" class="row g-2 align-items-center">
                <div class="col-md-4">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0"><i class="fas fa-search text-muted"></i></span>
                        <input type="text" name="search" class="form-control border-start-0" placeholder="Search part number, name, supplier..." value="@ViewBag.Search" />
                    </div>
                </div>
                <div class="col-md-3">
                    <select name="category" class="form-select">
                        <option value="">-- All Categories --</option>
                        <option value="Engine" selected="@(ViewBag.Category == "Engine")">Engine</option>
                        <option value="Braking" selected="@(ViewBag.Category == "Braking")">Braking</option>
                        <option value="Filters" selected="@(ViewBag.Category == "Filters")">Filters</option>
                        <option value="Fluids & Oils" selected="@(ViewBag.Category == "Fluids & Oils")">Fluids & Oils</option>
                        <option value="Electrical" selected="@(ViewBag.Category == "Electrical")">Electrical</option>
                        <option value="Transmission" selected="@(ViewBag.Category == "Transmission")">Transmission</option>
                        <option value="Suspension" selected="@(ViewBag.Category == "Suspension")">Suspension</option>
                        <option value="Tyres & Wheels" selected="@(ViewBag.Category == "Tyres & Wheels")">Tyres & Wheels</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <div class="form-check form-switch pt-2">
                        <input class="form-check-input" type="checkbox" name="lowStockOnly" value="true" id="lowStockSwitch" checked="@(ViewBag.LowStockOnly == true)">
                        <label class="form-check-label font-weight-bold text-dark" for="lowStockSwitch">
                            Low / Out of Stock Only
                        </label>
                    </div>
                </div>
                <div class="col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-dark w-100"><i class="fas fa-filter me-1"></i> Filter</button>
                    <a asp-action="Index" class="btn btn-outline-secondary"><i class="fas fa-undo"></i></a>
                </div>
            </form>
        </div>
    </div>

    <!-- Inventory Table -->
    <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Part Details</th>
                        <th>Category</th>
                        <th>Bin / Location</th>
                        <th>Unit Cost</th>
                        <th>Stock Level</th>
                        <th>Total Valuation</th>
                        <th>Supplier</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                <i class="fas fa-box-open fa-3x mb-3 text-secondary opacity-50"></i>
                                <p class="mb-0">No spare parts found in inventory matching your filters.</p>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var part in Model)
                        {
                            var categoryColor = part.Category switch
                            {
                                "Engine" => "bg-danger text-white",
                                "Braking" => "bg-danger bg-opacity-75 text-white",
                                "Filters" => "bg-warning text-dark",
                                "Fluids & Oils" => "bg-info text-dark",
                                "Electrical" => "bg-primary text-white",
                                "Transmission" => "bg-dark text-white",
                                _ => "bg-secondary text-white"
                            };

                            <tr class="@(part.IsOutOfStock ? "table-danger bg-opacity-25" : part.IsLowStock ? "table-warning bg-opacity-25" : "")">
                                <td class="ps-4">
                                    <div class="font-weight-bold text-dark">@part.PartName</div>
                                    <span class="badge bg-light text-dark border">
                                        <i class="fas fa-barcode me-1 text-muted"></i> @part.PartNumber
                                    </span>
                                </td>
                                <td>
                                    <span class="badge @categoryColor px-2 py-1">@part.Category</span>
                                </td>
                                <td>
                                    <span class="text-dark"><i class="fas fa-map-marker-alt text-muted me-1"></i> @(part.LocationBin ?? "General Rack")</span>
                                </td>
                                <td>
                                    <strong class="text-dark">₹@part.UnitCost.ToString("N2")</strong>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="fs-5 font-weight-bold @(part.IsOutOfStock ? "text-danger" : part.IsLowStock ? "text-warning font-weight-bold" : "text-success")">
                                            @part.QuantityInStock
                                        </span>
                                        <span class="text-muted small">units</span>
                                    </div>
                                    <div class="small text-muted">Min Reorder: @part.MinReorderLevel</div>
                                </td>
                                <td>
                                    <strong class="text-primary">₹@part.TotalStockValue.ToString("N2")</strong>
                                </td>
                                <td>
                                    <span class="text-muted small">@(part.SupplierName ?? "Standard Vendor")</span>
                                </td>
                                <td class="text-end pe-4">
                                    <div class="btn-group">
                                        <!-- Quick Restock Button -->
                                        <button type="button" class="btn btn-sm btn-outline-success" data-bs-toggle="modal" data-bs-target="#restockModal-@part.Id" title="Restock">
                                            <i class="fas fa-plus"></i> Restock
                                        </button>
                                        <!-- Quick Issue Button -->
                                        <a asp-action="Issue" asp-route-id="@part.Id" class="btn btn-sm btn-outline-info @(part.IsOutOfStock ? "disabled" : "")" title="Issue to Truck">
                                            <i class="fas fa-truck-pickup"></i> Issue
                                        </a>
                                        <!-- Edit -->
                                        <a asp-action="Edit" asp-route-id="@part.Id" class="btn btn-sm btn-outline-primary" title="Edit">
                                            <i class="fas fa-pencil-alt"></i>
                                        </a>
                                        <!-- Delete -->
                                        <form asp-action="Delete" asp-route-id="@part.Id" method="post" class="d-inline" onsubmit="return confirm('Delete spare part SKU from inventory?');">
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </form>
                                    </div>

                                    <!-- Restock Modal -->
                                    <div class="modal fade text-start" id="restockModal-@part.Id" tabindex="-1" aria-hidden="true">
                                        <div class="modal-dialog">
                                            <div class="modal-content rounded-4 border-0 shadow">
                                                <form asp-action="Restock" asp-route-id="@part.Id" method="post">
                                                    @Html.AntiForgeryToken()
                                                    <div class="modal-header bg-success text-white">
                                                        <h5 class="modal-title font-weight-bold">
                                                            <i class="fas fa-plus-circle me-1"></i> Restock: @part.PartName
                                                        </h5>
                                                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                                    </div>
                                                    <div class="modal-body">
                                                        <p class="text-muted mb-3">SKU: <strong>@part.PartNumber</strong> | Current Stock: <strong>@part.QuantityInStock units</strong></p>
                                                        <div class="mb-3">
                                                            <label class="form-label font-weight-bold">Quantity Received:</label>
                                                            <input type="number" name="quantity" class="form-control" min="1" value="5" required />
                                                        </div>
                                                        <div class="mb-3">
                                                            <label class="form-label font-weight-bold">Updated Unit Cost (₹) (Optional):</label>
                                                            <input type="number" step="0.01" name="newUnitCost" class="form-control" value="@part.UnitCost" />
                                                        </div>
                                                    </div>
                                                    <div class="modal-footer">
                                                        <button type="button" class="btn btn-secondary rounded-pill" data-bs-dismiss="modal">Cancel</button>
                                                        <button type="submit" class="btn btn-success rounded-pill px-4">Confirm Restock</button>
                                                    </div>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
