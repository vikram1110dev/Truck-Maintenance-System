@model Truck_Maintanance_system.Models.SparePart

@{
    ViewData["Title"] = "Edit Spare Part";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-dark text-white py-3 rounded-top-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <h4 class="mb-0 font-weight-bold">
                            <i class="fas fa-edit me-2 text-warning"></i> Edit Spare Part: @Model.PartName
                        </h4>
                        <a asp-action="Index" class="btn btn-outline-light btn-sm rounded-pill">
                            <i class="fas fa-arrow-left me-1"></i> Back to Inventory
                        </a>
                    </div>
                </div>

                <div class="card-body p-4">
                    <form asp-action="Edit" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="CreatedAt" />
                        <input type="hidden" asp-for="LastRestockedDate" />
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="PartNumber" class="form-label font-weight-bold"></label>
                                <input asp-for="PartNumber" class="form-control shadow-sm" />
                                <span asp-validation-for="PartNumber" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Category" class="form-label font-weight-bold"></label>
                                <select asp-for="Category" class="form-select shadow-sm">
                                    <option value="Engine">Engine</option>
                                    <option value="Braking">Braking</option>
                                    <option value="Filters">Filters</option>
                                    <option value="Fluids & Oils">Fluids & Oils</option>
                                    <option value="Electrical">Electrical</option>
                                    <option value="Transmission">Transmission</option>
                                    <option value="Suspension">Suspension</option>
                                    <option value="Tyres & Wheels">Tyres & Wheels</option>
                                    <option value="Body & Cabin">Body & Cabin</option>
                                </select>
                                <span asp-validation-for="Category" class="text-danger small"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="PartName" class="form-label font-weight-bold"></label>
                                <input asp-for="PartName" class="form-control shadow-sm" />
                                <span asp-validation-for="PartName" class="text-danger small"></span>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="UnitCost" class="form-label font-weight-bold"></label>
                                <div class="input-group shadow-sm">
                                    <span class="input-group-text">₹</span>
                                    <input asp-for="UnitCost" class="form-control" type="number" step="0.01" />
                                </div>
                                <span asp-validation-for="UnitCost" class="text-danger small"></span>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="QuantityInStock" class="form-label font-weight-bold"></label>
                                <input asp-for="QuantityInStock" class="form-control shadow-sm" type="number" />
                                <span asp-validation-for="QuantityInStock" class="text-danger small"></span>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="MinReorderLevel" class="form-label font-weight-bold"></label>
                                <input asp-for="MinReorderLevel" class="form-control shadow-sm" type="number" />
                                <span asp-validation-for="MinReorderLevel" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="LocationBin" class="form-label font-weight-bold"></label>
                                <input asp-for="LocationBin" class="form-control shadow-sm" />
                                <span asp-validation-for="LocationBin" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="SupplierName" class="form-label font-weight-bold"></label>
                                <input asp-for="SupplierName" class="form-control shadow-sm" />
                                <span asp-validation-for="SupplierName" class="text-danger small"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="Notes" class="form-label font-weight-bold"></label>
                                <textarea asp-for="Notes" class="form-control shadow-sm" rows="3"></textarea>
                                <span asp-validation-for="Notes" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                            <a asp-action="Index" class="btn btn-light rounded-pill px-4">Cancel</a>
                            <button type="submit" class="btn btn-primary rounded-pill px-5 shadow-sm">
                                <i class="fas fa-check-circle me-1"></i> Update Part
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
