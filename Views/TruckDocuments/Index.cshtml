@model IEnumerable<Truck_Maintanance_system.Models.TruckDocument>

@{
    ViewData["Title"] = "Truck Documents";
    var truck = ViewBag.Truck as Truck_Maintanance_system.Models.Truck;
}

<div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div class="d-flex align-items-center gap-3">
            <h1 class="h3 mb-0 text-gray-800">
                <i class="fas fa-folder-open text-primary mr-2"></i> Documents
            </h1>
            <form asp-action="Index" method="get" class="form-inline m-0">
                <select name="truckId" class="form-select font-weight-bold" onchange="this.form.submit()">
                    @foreach (var tk in (ViewBag.AllTrucks as IEnumerable<Truck_Maintanance_system.Models.Truck>) ?? Enumerable.Empty<Truck_Maintanance_system.Models.Truck>())
                    {
                        <option value="@tk.Id" selected="@(truck?.Id == tk.Id)">@tk.LicensePlate (@tk.Make @tk.Model)</option>
                    }
                </select>
            </form>
        </div>
        <a asp-action="Create" asp-route-truckId="@truck?.Id" class="btn btn-primary shadow-sm">
            <i class="fas fa-plus fa-sm text-white-50 mr-2"></i> Add New Document
        </a>
    </div>

    <div class="row">
        @if (!Model.Any())
        {
            <div class="col-12 text-center py-5">
                <i class="fas fa-file-alt fa-4x text-gray-300 mb-3"></i>
                <h4 class="text-gray-500">No documents found</h4>
                <p class="text-muted">Start by adding insurance, permits, or RC book for this truck.</p>
            </div>
        }
        
        @foreach (var doc in Model)
        {
            var daysUntilExpiry = (doc.ExpiryDate - DateTime.Now).TotalDays;
            var borderClass = "border-left-success";
            var textClass = "text-success";
            var statusIcon = "fa-check-circle";
            var statusText = "Valid";

            if (daysUntilExpiry < 0)
            {
                borderClass = "border-left-danger border-danger";
                textClass = "text-danger fw-bold";
                statusIcon = "fa-times-circle";
                statusText = "Expired";
            }
            else if (daysUntilExpiry <= 30)
            {
                borderClass = "border-left-warning border-warning";
                textClass = "text-warning fw-bold";
                statusIcon = "fa-exclamation-triangle";
                statusText = $"Expiring in {Math.Ceiling(daysUntilExpiry)} days";
            }

            <div class="col-xl-4 col-md-6 mb-4">
                <div class="card shadow-sm h-100 py-2 @borderClass">
                    <div class="card-body">
                        <div class="row no-gutters align-items-center">
                            <div class="col mr-2">
                                <div class="text-xs font-weight-bold text-uppercase mb-1 text-primary">
                                    @doc.DocumentType
                                </div>
                                <div class="h5 mb-0 font-weight-bold text-gray-800">
                                    @doc.DocumentNumber
                                </div>
                                @if(!string.IsNullOrEmpty(doc.Provider))
                                {
                                    <div class="small text-muted mt-1">@doc.Provider</div>
                                }
                                <div class="mt-2 small">
                                    <strong>Issue:</strong> @doc.IssueDate.ToShortDateString() <br/>
                                    <strong class="@textClass">Expiry: @doc.ExpiryDate.ToShortDateString()</strong>
                                </div>
                                <div class="mt-2">
                                    <span class="badge bg-light text-dark shadow-sm">
                                        <i class="fas @statusIcon @textClass mr-1"></i> @statusText
                                    </span>
                                </div>
                                @if(doc.Cost.HasValue)
                                {
                                    <div class="mt-2 small text-success font-weight-bold">Cost: ₹@doc.Cost.Value.ToString("F2")</div>
                                }
                            </div>
                            <div class="col-auto d-flex flex-column align-items-end">
                                @if(!string.IsNullOrEmpty(doc.AttachmentPath))
                                {
                                    <a href="@doc.AttachmentPath" target="_blank" class="btn btn-outline-primary btn-sm mb-1" title="View Attachment">
                                        <i class="fas fa-file-pdf"></i> View
                                    </a>
                                }
                                <a asp-action="Edit" asp-route-id="@doc.Id" class="btn btn-outline-warning btn-sm mb-1" title="Edit">
                                    <i class="fas fa-edit"></i> Edit
                                </a>
                                <form asp-action="Delete" asp-route-id="@doc.Id" method="post" onsubmit="return confirm('Are you sure you want to delete this document?');">
                                    <button type="submit" class="btn btn-outline-danger btn-sm" title="Delete">
                                        <i class="fas fa-trash"></i> Delete
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
