@model Truck_Maintanance_system.Models.ServiceReminder

@{
    ViewData["Title"] = "Edit Service Reminder";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-dark text-white py-3 rounded-top-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <h4 class="mb-0 font-weight-bold">
                            <i class="fas fa-edit me-2 text-warning"></i> Edit Service Reminder
                        </h4>
                        <a asp-action="Index" class="btn btn-outline-light btn-sm rounded-pill">
                            <i class="fas fa-arrow-left me-1"></i> Back to List
                        </a>
                    </div>
                </div>

                <div class="card-body p-4">
                    <form asp-action="Edit" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="CreatedAt" />
                        <input type="hidden" asp-for="CompletedAt" />
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="TruckId" class="form-label font-weight-bold"></label>
                                <select asp-for="TruckId" class="form-select shadow-sm" asp-items="ViewBag.TruckId">
                                </select>
                                <span asp-validation-for="TruckId" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="ServiceType" class="form-label font-weight-bold"></label>
                                <input asp-for="ServiceType" class="form-control shadow-sm" />
                                <span asp-validation-for="ServiceType" class="text-danger small"></span>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="DueDate" class="form-label font-weight-bold"></label>
                                <input asp-for="DueDate" class="form-control shadow-sm" type="date" />
                                <span asp-validation-for="DueDate" class="text-danger small"></span>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="DueOdometer" class="form-label font-weight-bold"></label>
                                <div class="input-group shadow-sm">
                                    <input asp-for="DueOdometer" class="form-control" type="number" />
                                    <span class="input-group-text">km</span>
                                </div>
                                <span asp-validation-for="DueOdometer" class="text-danger small"></span>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="Status" class="form-label font-weight-bold"></label>
                                <select asp-for="Status" class="form-select shadow-sm">
                                    <option value="Upcoming">Upcoming</option>
                                    <option value="Due Soon">Due Soon</option>
                                    <option value="Overdue">Overdue</option>
                                    <option value="Completed">Completed</option>
                                </select>
                                <span asp-validation-for="Status" class="text-danger small"></span>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="Priority" class="form-label font-weight-bold"></label>
                                <select asp-for="Priority" class="form-select shadow-sm">
                                    <option value="Low">Low</option>
                                    <option value="Medium">Medium</option>
                                    <option value="High">High</option>
                                    <option value="Critical">Critical</option>
                                </select>
                                <span asp-validation-for="Priority" class="text-danger small"></span>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="IntervalMonths" class="form-label font-weight-bold"></label>
                                <div class="input-group shadow-sm">
                                    <input asp-for="IntervalMonths" class="form-control" type="number" />
                                    <span class="input-group-text">months</span>
                                </div>
                                <span asp-validation-for="IntervalMonths" class="text-danger small"></span>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="IntervalKm" class="form-label font-weight-bold"></label>
                                <div class="input-group shadow-sm">
                                    <input asp-for="IntervalKm" class="form-control" type="number" />
                                    <span class="input-group-text">km</span>
                                </div>
                                <span asp-validation-for="IntervalKm" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="LastServicedDate" class="form-label font-weight-bold"></label>
                                <input asp-for="LastServicedDate" class="form-control shadow-sm" type="date" />
                                <span asp-validation-for="LastServicedDate" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="LastServicedOdometer" class="form-label font-weight-bold"></label>
                                <div class="input-group shadow-sm">
                                    <input asp-for="LastServicedOdometer" class="form-control" type="number" />
                                    <span class="input-group-text">km</span>
                                </div>
                                <span asp-validation-for="LastServicedOdometer" class="text-danger small"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="Notes" class="form-label font-weight-bold"></label>
                                <textarea asp-for="Notes" class="form-control shadow-sm" rows="3"></textarea>
                                <span asp-validation-for="Notes" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                            <a asp-action="Index" class="btn btn-light rounded-pill px-4">Cancel</a>
                            <button type="submit" class="btn btn-primary rounded-pill px-5 shadow-sm">
                                <i class="fas fa-save me-1"></i> Update Reminder
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
