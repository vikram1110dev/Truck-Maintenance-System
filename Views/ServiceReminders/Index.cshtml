@model IEnumerable<Truck_Maintanance_system.Models.ServiceReminder>

@{
    ViewData["Title"] = "Preventive Maintenance & Service Reminders";
}

<div class="container-fluid py-3">
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="font-weight-bold text-dark mb-1">
                <i class="fas fa-calendar-check text-primary"></i> Preventive Maintenance & Service Reminders
            </h2>
            <p class="text-muted mb-0">Track upcoming mileage & date-based services, inspections, and maintenance schedules.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary shadow-sm rounded-pill px-4">
            <i class="fas fa-plus-circle me-1"></i> Schedule New Service
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm rounded-3" role="alert">
            <i class="fas fa-check-circle me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Stat KPI Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card shadow-sm border-0 rounded-4 bg-light border-start border-4 border-primary p-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small text-uppercase font-weight-bold">Total Reminders</div>
                        <div class="h3 font-weight-bold text-dark mb-0">@ViewBag.TotalCount</div>
                    </div>
                    <div class="rounded-circle bg-primary bg-opacity-10 p-3 text-primary">
                        <i class="fas fa-bell fa-2x"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0 rounded-4 bg-light border-start border-4 border-danger p-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small text-uppercase font-weight-bold">Overdue Attention</div>
                        <div class="h3 font-weight-bold text-danger mb-0">@ViewBag.OverdueCount</div>
                    </div>
                    <div class="rounded-circle bg-danger bg-opacity-10 p-3 text-danger">
                        <i class="fas fa-exclamation-circle fa-2x"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0 rounded-4 bg-light border-start border-4 border-warning p-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small text-uppercase font-weight-bold">Due Soon (7 Days / 500km)</div>
                        <div class="h3 font-weight-bold text-warning mb-0">@ViewBag.DueSoonCount</div>
                    </div>
                    <div class="rounded-circle bg-warning bg-opacity-10 p-3 text-warning">
                        <i class="fas fa-clock fa-2x"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0 rounded-4 bg-light border-start border-4 border-success p-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small text-uppercase font-weight-bold">Completed Services</div>
                        <div class="h3 font-weight-bold text-success mb-0">@ViewBag.CompletedCount</div>
                    </div>
                    <div class="rounded-circle bg-success bg-opacity-10 p-3 text-success">
                        <i class="fas fa-check-double fa-2x"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filters and Search Bar -->
    <div class="card shadow-sm border-0 rounded-4 mb-4">
        <div class="card-body p-3">
            <form method="get" class="row g-2 align-items-center">
                <div class="col-md-3">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0"><i class="fas fa-search text-muted"></i></span>
                        <input type="text" name="search" class="form-control border-start-0" placeholder="Search service or truck..." value="@ViewBag.Search" />
                    </div>
                </div>
                <div class="col-md-2">
                    <select name="status" class="form-select">
                        <option value="">-- All Statuses --</option>
                        <option value="Upcoming" selected="@(ViewBag.CurrentStatus == "Upcoming")">Upcoming</option>
                        <option value="Due Soon" selected="@(ViewBag.CurrentStatus == "Due Soon")">Due Soon</option>
                        <option value="Overdue" selected="@(ViewBag.CurrentStatus == "Overdue")">Overdue</option>
                        <option value="Completed" selected="@(ViewBag.CurrentStatus == "Completed")">Completed</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <select name="priority" class="form-select">
                        <option value="">-- All Priorities --</option>
                        <option value="Critical" selected="@(ViewBag.CurrentPriority == "Critical")">Critical</option>
                        <option value="High" selected="@(ViewBag.CurrentPriority == "High")">High</option>
                        <option value="Medium" selected="@(ViewBag.CurrentPriority == "Medium")">Medium</option>
                        <option value="Low" selected="@(ViewBag.CurrentPriority == "Low")">Low</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <select name="truckId" class="form-select" asp-items="ViewBag.TrucksList">
                        <option value="">-- Filter by Truck --</option>
                    </select>
                </div>
                <div class="col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-dark w-100"><i class="fas fa-filter me-1"></i> Filter</button>
                    <a asp-action="Index" class="btn btn-outline-secondary"><i class="fas fa-undo"></i></a>
                </div>
            </form>
        </div>
    </div>

    <!-- Service Reminders Table -->
    <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Truck</th>
                        <th>Service Type</th>
                        <th>Priority</th>
                        <th>Target Due Date</th>
                        <th>Target Due Odometer</th>
                        <th>Recurrence Interval</th>
                        <th>Status</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                <i class="fas fa-clipboard-list fa-3x mb-3 text-secondary opacity-50"></i>
                                <p class="mb-0">No service reminders found matching criteria.</p>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            var priorityBadge = item.Priority switch
                            {
                                "Critical" => "bg-danger text-white",
                                "High" => "bg-warning text-dark font-weight-bold",
                                "Medium" => "bg-info text-white",
                                _ => "bg-secondary text-white"
                            };

                            var statusBadge = item.Status switch
                            {
                                "Overdue" => "badge bg-danger p-2",
                                "Due Soon" => "badge bg-warning text-dark p-2",
                                "Completed" => "badge bg-success p-2",
                                _ => "badge bg-primary bg-opacity-75 p-2"
                            };

                            <tr>
                                <td class="ps-4 font-weight-bold">
                                    <div class="d-flex align-items-center">
                                        <i class="fas fa-truck text-muted me-2"></i>
                                        <div>
                                            <span class="text-dark">@(item.Truck?.LicensePlate ?? "N/A")</span>
                                            <div class="small text-muted">@(item.Truck?.Make) @(item.Truck?.Model) (Odo: @(item.Truck?.CurrentOdometer.ToString("N0") ?? "0") km)</div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="font-weight-bold text-dark">@item.ServiceType</span>
                                    @if (!string.IsNullOrEmpty(item.Notes))
                                    {
                                        <div class="small text-muted text-truncate" style="max-width: 220px;" title="@item.Notes">
                                            <i class="fas fa-info-circle me-1"></i> @item.Notes
                                        </div>
                                    }
                                </td>
                                <td>
                                    <span class="badge @priorityBadge px-2 py-1">@item.Priority</span>
                                </td>
                                <td>
                                    @if (item.DueDate.HasValue)
                                    {
                                        var daysLeft = (item.DueDate.Value.Date - DateTime.Today).Days;
                                        <div class="@(daysLeft < 0 && item.Status != "Completed" ? "text-danger font-weight-bold" : "text-dark")">
                                            <i class="far fa-calendar-alt me-1 text-muted"></i> @item.DueDate.Value.ToString("dd MMM yyyy")
                                        </div>
                                        @if (item.Status != "Completed")
                                        {
                                            <small class="text-muted">
                                                @(daysLeft < 0 ? $"{Math.Abs(daysLeft)} days overdue" : daysLeft == 0 ? "Due today!" : $"{daysLeft} days remaining")
                                            </small>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    @if (item.DueOdometer.HasValue)
                                    {
                                        int currentOdo = item.Truck?.CurrentOdometer ?? 0;
                                        int kmLeft = item.DueOdometer.Value - currentOdo;
                                        <div class="@(kmLeft <= 0 && item.Status != "Completed" ? "text-danger font-weight-bold" : "text-dark")">
                                            <i class="fas fa-tachometer-alt me-1 text-muted"></i> @item.DueOdometer.Value.ToString("N0") km
                                        </div>
                                        @if (item.Status != "Completed")
                                        {
                                            <small class="text-muted">
                                                @(kmLeft <= 0 ? $"{Math.Abs(kmLeft):N0} km exceeded" : $"{kmLeft:N0} km remaining")
                                            </small>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    @if (item.IntervalMonths.HasValue || item.IntervalKm.HasValue)
                                    {
                                        <div class="small">
                                            @if (item.IntervalMonths.HasValue && item.IntervalMonths > 0)
                                            {
                                                <span class="badge bg-light text-dark border me-1"><i class="fas fa-redo me-1"></i> @item.IntervalMonths mo</span>
                                            }
                                            @if (item.IntervalKm.HasValue && item.IntervalKm > 0)
                                            {
                                                <span class="badge bg-light text-dark border"><i class="fas fa-road me-1"></i> @item.IntervalKm.Value.ToString("N0") km</span>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-muted border">One-time</span>
                                    }
                                </td>
                                <td>
                                    <span class="@statusBadge">@item.Status</span>
                                    @if (item.CompletedAt.HasValue)
                                    {
                                        <div class="small text-muted">@item.CompletedAt.Value.ToString("dd MMM yyyy")</div>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <div class="btn-group">
                                        @if (item.Status != "Completed")
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-success" data-bs-toggle="modal" data-bs-target="#completeModal-@item.Id" title="Mark as Completed">
                                                <i class="fas fa-check"></i> Done
                                            </button>
                                        }
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" title="Edit">
                                            <i class="fas fa-pencil-alt"></i>
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this reminder?');">
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </form>
                                    </div>

                                    <!-- Complete Modal -->
                                    <div class="modal fade text-start" id="completeModal-@item.Id" tabindex="-1" aria-hidden="true">
                                        <div class="modal-dialog">
                                            <div class="modal-content rounded-4 border-0 shadow">
                                                <form asp-action="Complete" asp-route-id="@item.Id" method="post">
                                                    @Html.AntiForgeryToken()
                                                    <div class="modal-header bg-success text-white">
                                                        <h5 class="modal-title font-weight-bold">
                                                            <i class="fas fa-check-circle me-1"></i> Complete Service: @item.ServiceType
                                                        </h5>
                                                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                                    </div>
                                                    <div class="modal-body">
                                                        <p class="text-muted">Truck: <strong>@(item.Truck?.LicensePlate)</strong></p>
                                                        <div class="mb-3">
                                                            <label class="form-label font-weight-bold">Completion Notes / Work Done:</label>
                                                            <textarea name="completionNotes" class="form-control" rows="3" placeholder="e.g. Engine oil changed with Mobil 15W-40, new OEM filter installed."></textarea>
                                                        </div>
                                                        @if (item.IntervalMonths.HasValue || item.IntervalKm.HasValue)
                                                        {
                                                            <div class="form-check form-switch p-3 bg-light rounded-3">
                                                                <input class="form-check-input ms-0 me-2" type="checkbox" name="createNextCycle" value="true" checked id="switchNextCycle-@item.Id">
                                                                <label class="form-check-label font-weight-bold" for="switchNextCycle-@item.Id">
                                                                    Automatically schedule next service cycle
                                                                </label>
                                                                <div class="small text-muted">Will compute the next due date and odometer based on interval (@(item.IntervalMonths) mo / @(item.IntervalKm) km).</div>
                                                            </div>
                                                        }
                                                    </div>
                                                    <div class="modal-footer">
                                                        <button type="button" class="btn btn-secondary rounded-pill" data-bs-dismiss="modal">Cancel</button>
                                                        <button type="submit" class="btn btn-success rounded-pill px-4">Confirm Completion</button>
                                                    </div>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
