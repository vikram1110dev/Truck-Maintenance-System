@model IEnumerable<Truck_Maintanance_system.Models.VehicleInspectionReport>

@{
    ViewData["Title"] = "Vehicle Inspection Reports (DVIR)";
}

<div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="h3 font-weight-bold text-gray-800 mb-1">
                <i class="fas fa-clipboard-check text-primary mr-2"></i> Daily Vehicle Inspection Reports (DVIR)
            </h2>
            <p class="text-muted small mb-0">Pre-trip & Post-trip safety checklists, driver defect reports, and roadworthiness compliance.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary shadow-sm rounded-pill px-4">
            <i class="fas fa-plus mr-1"></i> New Inspection Checklist
        </a>
    </div>

    <!-- Summary KPI Cards -->
    <div class="row mb-4">
        <div class="col-xl-3 col-md-6 mb-3">
            <div class="card border-left-primary shadow-sm h-100 py-2">
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">Total Inspections</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">@ViewBag.TotalInspections</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-clipboard-list fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-3">
            <div class="card border-left-success shadow-sm h-100 py-2">
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-success text-uppercase mb-1">Passed (Safe to Drive)</div>
                            <div class="h5 mb-0 font-weight-bold text-success">@ViewBag.PassedCount</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-check-circle fa-2x text-success"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-3">
            <div class="card border-left-danger shadow-sm h-100 py-2">
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-danger text-uppercase mb-1">Defects Flagged</div>
                            <div class="h5 mb-0 font-weight-bold text-danger">@ViewBag.DefectCount</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-exclamation-triangle fa-2x text-danger"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-3">
            <div class="card border-left-info shadow-sm h-100 py-2">
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-info text-uppercase mb-1">Pre-Trip Inspections</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">@ViewBag.PreTripCount</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-truck-pickup fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filters -->
    <div class="card shadow-sm mb-4">
        <div class="card-body py-3">
            <form method="get" class="row align-items-end g-3">
                <div class="col-md-3">
                    <label class="small font-weight-bold mb-1 text-muted">Filter By Truck</label>
                    <select name="truckId" class="form-control form-control-sm" asp-items="ViewBag.Trucks">
                        <option value="">-- All Trucks --</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="small font-weight-bold mb-1 text-muted">Inspection Type</label>
                    <select name="type" class="form-control form-control-sm" asp-items="Html.GetEnumSelectList<Truck_Maintanance_system.Models.InspectionType>()">
                        <option value="">-- All Types --</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <div class="form-check mt-3">
                        <input class="form-check-input" type="checkbox" name="onlyDefects" value="true" id="defectCheck" @(ViewBag.OnlyDefects == true ? "checked" : "") />
                        <label class="form-check-label small font-weight-bold text-danger" for="defectCheck">
                            Show Defect / Unsafe Only
                        </label>
                    </div>
                </div>
                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary btn-sm rounded-pill px-3">
                        <i class="fas fa-filter mr-1"></i> Filter
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                        <i class="fas fa-undo mr-1"></i> Reset
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Inspections Table -->
    <div class="card shadow-sm">
        <div class="card-header bg-white py-3">
            <h6 class="m-0 font-weight-bold text-primary"><i class="fas fa-list mr-1"></i> Inspection Checklist History</h6>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped align-middle mb-0">
                    <thead class="thead-light">
                        <tr>
                            <th>Date & Time</th>
                            <th>Truck</th>
                            <th>Driver</th>
                            <th>Type</th>
                            <th>Odometer</th>
                            <th>Checklist Status</th>
                            <th>Safety Decision</th>
                            <th class="text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="8" class="text-center py-4 text-muted">
                                    <i class="fas fa-clipboard-check fa-2x mb-2 d-block text-gray-400"></i>
                                    No vehicle inspection records found.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model)
                            {
                                <tr class="@(!item.IsSafeToOperate ? "table-danger" : (item.HasDefects ? "table-warning" : ""))">
                                    <td>
                                        <strong>@item.InspectionDate.ToString("dd MMM yyyy")</strong>
                                        <div class="text-muted small">@item.InspectionDate.ToString("hh:mm tt")</div>
                                    </td>
                                    <td>
                                        <span class="badge badge-primary px-2 py-1">@item.Truck?.LicensePlate</span>
                                    </td>
                                    <td>@item.DriverName</td>
                                    <td>
                                        <span class="badge badge-light border">@item.Type</span>
                                    </td>
                                    <td>@item.OdometerReading.ToString("N0") km</td>
                                    <td>
                                        <div class="d-flex gap-1">
                                            <span class="badge @(item.BrakesOk ? "badge-success" : "badge-danger")" title="Brakes">B</span>
                                            <span class="badge @(item.LightsAndSignalsOk ? "badge-success" : "badge-danger")" title="Lights">L</span>
                                            <span class="badge @(item.TyresAndWheelsOk ? "badge-success" : "badge-danger")" title="Tyres">T</span>
                                            <span class="badge @(item.EngineOilAndFluidsOk ? "badge-success" : "badge-danger")" title="Fluids">F</span>
                                            <span class="badge @(item.SteeringAndHornOk ? "badge-success" : "badge-danger")" title="Steering">S</span>
                                            <span class="badge @(item.WipersAndGlassOk ? "badge-success" : "badge-danger")" title="Wipers">W</span>
                                        </div>
                                    </td>
                                    <td>
                                        @if (item.IsSafeToOperate)
                                        {
                                            <span class="badge badge-success px-2 py-1"><i class="fas fa-check-circle mr-1"></i> Safe / Pass</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-danger px-2 py-1"><i class="fas fa-ban mr-1"></i> Unsafe / Grounded</span>
                                        }
                                    </td>
                                    <td class="text-right">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-light text-primary" title="View Full Report">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        @if (User.IsInRole("Admin"))
                                        {
                                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-light text-danger" title="Delete">
                                                <i class="fas fa-trash"></i>
                                            </a>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
