@model Truck_Maintanance_system.Models.VehicleInspectionReport

@{
    ViewData["Title"] = "Inspection Report Details";
}

<div class="container mt-4 mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow border-0">
                <div class="card-header @(Model.IsSafeToOperate ? "bg-success text-white" : "bg-danger text-white") py-3 d-flex justify-content-between align-items-center">
                    <h5 class="m-0 font-weight-bold">
                        <i class="fas fa-clipboard-check mr-2"></i> DVIR Report #@Model.Id (@Model.Type)
                    </h5>
                    <span class="badge @(Model.IsSafeToOperate ? "badge-light text-success font-weight-bold" : "badge-light text-danger font-weight-bold") px-3 py-2">
                        @(Model.IsSafeToOperate ? "PASSED - ROADWORTHY" : "DEFECTIVE / GROUNDED")
                    </span>
                </div>
                <div class="card-body">
                    <div class="row mb-4">
                        <div class="col-sm-6">
                            <h6 class="text-muted small mb-1">Vehicle</h6>
                            <h5 class="font-weight-bold">@Model.Truck?.LicensePlate (@Model.Truck?.Make @Model.Truck?.Model)</h5>
                        </div>
                        <div class="col-sm-6 text-sm-right">
                            <h6 class="text-muted small mb-1">Date & Time</h6>
                            <h5 class="font-weight-bold">@Model.InspectionDate.ToString("dd MMMM yyyy, hh:mm tt")</h5>
                        </div>
                    </div>

                    <div class="row mb-4">
                        <div class="col-sm-6">
                            <div class="text-muted small">Inspecting Driver</div>
                            <div class="font-weight-bold">@Model.DriverName</div>
                        </div>
                        <div class="col-sm-6 text-sm-right">
                            <div class="text-muted small">Odometer Reading</div>
                            <div class="font-weight-bold">@Model.OdometerReading.ToString("N0") km</div>
                        </div>
                    </div>

                    <hr />

                    <h6 class="font-weight-bold mb-3"><i class="fas fa-tasks text-primary mr-1"></i> Inspection Items Verified</h6>
                    <div class="row mb-4">
                        <div class="col-md-6 mb-2">
                            <div class="d-flex align-items-center justify-content-between p-2 border rounded">
                                <span>Brake System:</span>
                                @if (Model.BrakesOk)
                                {
                                    <span class="badge badge-success"><i class="fas fa-check"></i> PASS</span>
                                }
                                else
                                {
                                    <span class="badge badge-danger"><i class="fas fa-times"></i> DEFECT</span>
                                }
                            </div>
                        </div>

                        <div class="col-md-6 mb-2">
                            <div class="d-flex align-items-center justify-content-between p-2 border rounded">
                                <span>Lights & Signals:</span>
                                @if (Model.LightsAndSignalsOk)
                                {
                                    <span class="badge badge-success"><i class="fas fa-check"></i> PASS</span>
                                }
                                else
                                {
                                    <span class="badge badge-danger"><i class="fas fa-times"></i> DEFECT</span>
                                }
                            </div>
                        </div>

                        <div class="col-md-6 mb-2">
                            <div class="d-flex align-items-center justify-content-between p-2 border rounded">
                                <span>Tyres & Wheels:</span>
                                @if (Model.TyresAndWheelsOk)
                                {
                                    <span class="badge badge-success"><i class="fas fa-check"></i> PASS</span>
                                }
                                else
                                {
                                    <span class="badge badge-danger"><i class="fas fa-times"></i> DEFECT</span>
                                }
                            </div>
                        </div>

                        <div class="col-md-6 mb-2">
                            <div class="d-flex align-items-center justify-content-between p-2 border rounded">
                                <span>Engine Oil & Fluids:</span>
                                @if (Model.EngineOilAndFluidsOk)
                                {
                                    <span class="badge badge-success"><i class="fas fa-check"></i> PASS</span>
                                }
                                else
                                {
                                    <span class="badge badge-danger"><i class="fas fa-times"></i> DEFECT</span>
                                }
                            </div>
                        </div>

                        <div class="col-md-6 mb-2">
                            <div class="d-flex align-items-center justify-content-between p-2 border rounded">
                                <span>Steering & Horn:</span>
                                @if (Model.SteeringAndHornOk)
                                {
                                    <span class="badge badge-success"><i class="fas fa-check"></i> PASS</span>
                                }
                                else
                                {
                                    <span class="badge badge-danger"><i class="fas fa-times"></i> DEFECT</span>
                                }
                            </div>
                        </div>

                        <div class="col-md-6 mb-2">
                            <div class="d-flex align-items-center justify-content-between p-2 border rounded">
                                <span>Windshield & Wipers:</span>
                                @if (Model.WipersAndGlassOk)
                                {
                                    <span class="badge badge-success"><i class="fas fa-check"></i> PASS</span>
                                }
                                else
                                {
                                    <span class="badge badge-danger"><i class="fas fa-times"></i> DEFECT</span>
                                }
                            </div>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.DefectsDescription))
                    {
                        <div class="alert alert-danger mb-4">
                            <h6 class="font-weight-bold mb-1"><i class="fas fa-exclamation-triangle mr-1"></i> Reported Defects / Observations:</h6>
                            <p class="mb-0">@Model.DefectsDescription</p>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(Model.Remarks))
                    {
                        <div class="alert alert-light border mb-4">
                            <h6 class="font-weight-bold small text-muted mb-1">Remarks:</h6>
                            <p class="mb-0">@Model.Remarks</p>
                        </div>
                    }

                    <div class="d-flex justify-content-between mt-4">
                        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                            <i class="fas fa-arrow-left mr-1"></i> Back to Reports
                        </a>
                        @if (User.IsInRole("Admin"))
                        {
                            <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger rounded-pill px-4">
                                <i class="fas fa-trash mr-1"></i> Delete
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
