@model IEnumerable<Truck_Maintanance_system.Models.TripRecord>

@{
    ViewData["Title"] = "Logged Trips";
}

<div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0 text-gray-800">
            <i class="fas fa-route text-primary mr-2"></i> Trip Logs
        </h1>
        <div>
            <a asp-action="FuelAnalytics" class="btn btn-info shadow-sm mr-2 text-white">
                <i class="fas fa-gas-pump fa-sm mr-1"></i> Fuel Analytics
            </a>
            <a asp-action="Create" class="btn btn-primary shadow-sm">
                <i class="fas fa-plus fa-sm text-white-50 mr-2"></i> Log New Trip
            </a>
        </div>
    </div>

    <!-- Search & Filter Bar -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body py-2">
            <form asp-action="Index" method="get" class="d-flex align-items-center flex-wrap gap-2">
                <div class="input-group mr-2" style="max-width: 350px;">
                    <input type="text" name="search" value="@ViewBag.Search" class="form-control border-0 bg-light" placeholder="Search route or plate..." />
                    <div class="input-group-append">
                        <button class="btn btn-primary" type="submit">
                            <i class="fas fa-search"></i>
                        </button>
                    </div>
                </div>
                <select name="status" class="form-select mr-2" style="max-width: 170px;" onchange="this.form.submit()">
                    <option value="">All Status</option>
                    @foreach (var s in Enum.GetValues<Truck_Maintanance_system.Models.TripStatus>())
                    {
                        <option value="@s" selected="@(ViewBag.StatusFilter == s.ToString())">@s</option>
                    }
                </select>
                @if (!string.IsNullOrEmpty(ViewBag.Search as string) || !string.IsNullOrEmpty(ViewBag.StatusFilter as string))
                {
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="fas fa-times"></i> Clear
                    </a>
                }
            </form>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="bg-light text-dark">
                        <tr>
                            <th>Truck</th>
                            <th>Driver</th>
                            <th>Route</th>
                            <th>Dates</th>
                            <th>Revenue</th>
                            <th>Profit</th>
                            <th>Fuel Effic.</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="9" class="text-center py-4 text-muted">
                                    No trips found.
                                </td>
                            </tr>
                        }
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="align-middle font-weight-bold text-primary">
                                    <i class="fas fa-truck mr-1"></i> @item.Truck?.LicensePlate
                                </td>
                                <td class="align-middle text-info">
                                    <i class="fas fa-user-tie mr-1"></i> @(item.Driver?.UserName?.Split('@')[0] ?? "Unassigned")
                                </td>
                                <td class="align-middle">
                                    @item.RouteStart <i class="fas fa-arrow-right text-muted mx-1"></i> @item.RouteEnd
                                </td>
                                <td class="align-middle small text-muted">
                                    @item.StartDate.ToShortDateString() - @item.EndDate.ToShortDateString()
                                </td>
                                <td class="align-middle font-weight-bold text-success">
                                    ₹@item.FreightRevenue.ToString("N0")
                                </td>
                                <td class="align-middle font-weight-bold @(item.NetTripProfit >= 0 ? "text-success" : "text-danger")">
                                    ₹@item.NetTripProfit.ToString("N0")
                                </td>
                                <td class="align-middle">
                                    @if(item.FuelEfficiency > 0)
                                    {
                                        <span class="badge @(item.FuelEfficiency >= 3.5m ? "badge-success" : (item.FuelEfficiency < 2.5m ? "badge-danger" : "badge-warning")) p-2">
                                            @item.FuelEfficiency km/l
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">N/A</span>
                                    }
                                </td>
                                <td class="align-middle">
                                    @{
                                        var statusBadge = item.Status switch
                                        {
                                            Truck_Maintanance_system.Models.TripStatus.Completed => "badge-success",
                                            Truck_Maintanance_system.Models.TripStatus.InProgress => "badge-primary",
                                            Truck_Maintanance_system.Models.TripStatus.Cancelled => "badge-secondary",
                                            _ => "badge-secondary"
                                        };
                                    }
                                    <span class="badge @statusBadge p-2">@item.Status</span>
                                </td>
                                <td class="align-middle">
                                    <div class="d-flex align-items-center">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning mr-1" title="Edit">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <a asp-controller="LiveTracking" asp-action="Track" asp-route-tripId="@item.Id" class="btn btn-sm btn-outline-success mr-1" title="View Live Map">
                                            <i class="fas fa-map-marked-alt"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" title="Delete">
                                            <i class="fas fa-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
