@model IEnumerable<Truck_Maintanance_system.Models.TripRecord>

@{
    ViewData["Title"] = "Logged Trips";
}

<div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0 text-gray-800">
            <i class="fas fa-route text-primary mr-2"></i> Trip Logs
        </h1>
        <a asp-action="Create" class="btn btn-primary shadow-sm">
            <i class="fas fa-plus fa-sm text-white-50 mr-2"></i> Log New Trip
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="bg-light text-dark">
                        <tr>
                            <th>Truck</th>
                            <th>Route</th>
                            <th>Dates</th>
                            <th>Revenue</th>
                            <th>Profit</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center py-4 text-muted">
                                    No trips logged yet.
                                </td>
                            </tr>
                        }
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="align-middle font-weight-bold text-primary">
                                    <i class="fas fa-truck mr-1"></i> @item.Truck?.LicensePlate
                                </td>
                                <td class="align-middle">
                                    @item.RouteStart <i class="fas fa-arrow-right text-muted mx-1"></i> @item.RouteEnd
                                </td>
                                <td class="align-middle small text-muted">
                                    @item.StartDate.ToShortDateString() - @item.EndDate.ToShortDateString()
                                </td>
                                <td class="align-middle font-weight-bold text-success">
                                    ₹@item.FreightRevenue.ToString("N2")
                                </td>
                                <td class="align-middle font-weight-bold @(item.NetTripProfit >= 0 ? "text-success" : "text-danger")">
                                    ₹@item.NetTripProfit.ToString("N2")
                                </td>
                                <td class="align-middle">
                                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Delete this trip record?');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete Trip">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
