@model Truck_Maintanance_system.Models.TripRecord

@{
    ViewData["Title"] = "Log Trip";
}

<div class="container mt-4 mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card shadow-sm border-0 rounded-lg">
                <div class="card-header bg-primary text-white pt-4 pb-3">
                    <h5 class="m-0 font-weight-bold">
                        <i class="fas fa-route mr-2"></i> Log Trip Revenue & Expenses
                    </h5>
                </div>
                <div class="card-body bg-light">
                    <form asp-action="Create" class="needs-validation">
                        
                        <!-- Core Details -->
                        <div class="card shadow-sm border-0 mb-4">
                            <div class="card-body">
                                <h6 class="font-weight-bold text-primary border-bottom pb-2 mb-3">Trip Details</h6>
                                
                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label asp-for="TruckId" class="form-label font-weight-bold"></label>
                                        <select asp-for="TruckId" class="form-select" asp-items="@(new SelectList(ViewBag.Trucks, "Id", "LicensePlate"))" required>
                                            <option value="">-- Select Truck --</option>
                                        </select>
                                        <span asp-validation-for="TruckId" class="text-danger"></span>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label asp-for="DriverId" class="form-label font-weight-bold"></label>
                                        <select asp-for="DriverId" class="form-select" asp-items="@(new SelectList(ViewBag.Drivers, "Id", "UserName"))" required>
                                            <option value="">-- Select Driver --</option>
                                        </select>
                                        <span asp-validation-for="DriverId" class="text-danger"></span>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label asp-for="RouteStart" class="form-label font-weight-bold"></label>
                                        <input asp-for="RouteStart" class="form-control" placeholder="e.g. Chennai" required />
                                        <span asp-validation-for="RouteStart" class="text-danger"></span>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label asp-for="RouteEnd" class="form-label font-weight-bold"></label>
                                        <input asp-for="RouteEnd" class="form-control" placeholder="e.g. Mumbai" required />
                                        <span asp-validation-for="RouteEnd" class="text-danger"></span>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label asp-for="StartDate" class="form-label font-weight-bold"></label>
                                        <input asp-for="StartDate" type="date" class="form-control" required />
                                        <span asp-validation-for="StartDate" class="text-danger"></span>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label asp-for="EndDate" class="form-label font-weight-bold"></label>
                                        <input asp-for="EndDate" type="date" class="form-control" required />
                                        <span asp-validation-for="EndDate" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Trip Metrics -->
                        <div class="card shadow-sm border-0 mb-4">
                            <div class="card-body">
                                <h6 class="font-weight-bold text-info border-bottom pb-2 mb-3">Trip Metrics (Optional)</h6>
                                
                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label asp-for="DistanceKm" class="form-label font-weight-bold"></label>
                                        <div class="input-group">
                                            <input asp-for="DistanceKm" type="number" step="0.1" class="form-control" placeholder="0.0" />
                                            <span class="input-group-text">km</span>
                                        </div>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label asp-for="FuelVolumeLiters" class="form-label font-weight-bold"></label>
                                        <div class="input-group">
                                            <input asp-for="FuelVolumeLiters" type="number" step="0.1" class="form-control" placeholder="0.0" />
                                            <span class="input-group-text">Liters</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Financials -->
                        <div class="card shadow-sm border-0 mb-4">
                            <div class="card-body">
                                <h6 class="font-weight-bold text-success border-bottom pb-2 mb-3">Financials (Revenue & Expenses)</h6>
                                
                                <div class="mb-4">
                                    <label asp-for="FreightRevenue" class="form-label font-weight-bold text-success">Total Freight Revenue</label>
                                    <div class="input-group input-group-lg shadow-sm">
                                        <span class="input-group-text bg-success text-white border-success">₹</span>
                                        <input asp-for="FreightRevenue" type="number" step="0.01" class="form-control border-success text-success font-weight-bold" placeholder="0.00" required />
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label asp-for="FuelCost" class="form-label font-weight-bold text-danger"></label>
                                        <div class="input-group">
                                            <span class="input-group-text">₹</span>
                                            <input asp-for="FuelCost" type="number" step="0.01" class="form-control" placeholder="0.00" value="0" />
                                        </div>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label asp-for="TollCost" class="form-label font-weight-bold text-danger"></label>
                                        <div class="input-group">
                                            <span class="input-group-text">₹</span>
                                            <input asp-for="TollCost" type="number" step="0.01" class="form-control" placeholder="0.00" value="0" />
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label asp-for="DriverAllowance" class="form-label font-weight-bold text-danger"></label>
                                        <div class="input-group">
                                            <span class="input-group-text">₹</span>
                                            <input asp-for="DriverAllowance" type="number" step="0.01" class="form-control" placeholder="0.00" value="0" />
                                        </div>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label asp-for="OtherExpenses" class="form-label font-weight-bold text-danger"></label>
                                        <div class="input-group">
                                            <span class="input-group-text">₹</span>
                                            <input asp-for="OtherExpenses" type="number" step="0.01" class="form-control" placeholder="0.00" value="0" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between pt-2">
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                            <button type="submit" class="btn btn-primary shadow-sm px-5 btn-lg">
                                <i class="fas fa-save mr-1"></i> Save Trip Record
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
