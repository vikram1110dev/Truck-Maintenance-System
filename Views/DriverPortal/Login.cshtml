@{
    ViewData["Title"] = "Driver Login";
    Layout = "_DriverLayout";
}

<div class="row justify-content-center mt-5">
    <div class="col-12 col-md-8 col-lg-5">
        <div class="card shadow-lg border-0 rounded-lg">
            <div class="card-header bg-white text-center py-4 border-0">
                <i class="fas fa-truck-moving fa-4x text-success mb-3"></i>
                <h4 class="font-weight-bold text-gray-800">Driver Portal</h4>
                <p class="text-muted small">Select your assigned truck to continue</p>
            </div>
            <div class="card-body px-5 pb-5">
                <form asp-action="Login" method="post">
                    <div class="form-group mb-4">
                        <label class="font-weight-bold text-dark">Your Truck</label>
                        <select name="truckId" class="form-control form-control-lg border-success" asp-items="ViewBag.Trucks" required>
                            <option value="">-- Select Truck --</option>
                        </select>
                        <small class="form-text text-muted mt-2">
                            Select the license plate of the truck you are currently driving.
                        </small>
                    </div>

                    @Html.ValidationSummary(true, "", new { @class = "text-danger mb-3" })

                    <button type="submit" class="btn btn-success btn-lg btn-block shadow-sm">
                        Enter Portal <i class="fas fa-arrow-right ml-2"></i>
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
