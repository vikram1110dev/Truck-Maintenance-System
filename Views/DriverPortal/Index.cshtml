@model Truck_Maintanance_system.Models.TripRecord

@{
    ViewData["Title"] = "Driver Dashboard";
    Layout = "_DriverLayout";
    var licensePlate = ViewBag.LicensePlate as string;
}

<div class="row justify-content-center">
    <div class="col-12 col-md-10 col-lg-8">
        
        <div class="d-flex align-items-center justify-content-between mb-4 mt-2">
            <h1 class="h4 mb-0 text-gray-800 font-weight-bold">Welcome, Driver</h1>
            <span class="badge badge-success p-2" style="font-size: 1rem;"><i class="fas fa-truck mr-1"></i> @licensePlate</span>
        </div>

        @if (ViewBag.TotalSalary != null)
        {
            <div class="row mb-4">
                <div class="col-6">
                    <div class="card border-left-success shadow h-100 py-2">
                        <div class="card-body">
                            <div class="row no-gutters align-items-center">
                                <div class="col mr-2">
                                    <div class="text-xs font-weight-bold text-success text-uppercase mb-1">
                                        Your Earnings</div>
                                    <div class="h5 mb-0 font-weight-bold text-gray-800">₹@Convert.ToDecimal(ViewBag.TotalSalary).ToString("N2")</div>
                                </div>
                                <div class="col-auto">
                                    <i class="fas fa-rupee-sign fa-2x text-gray-300"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-6">
                    <div class="card border-left-info shadow h-100 py-2">
                        <div class="card-body">
                            <div class="row no-gutters align-items-center">
                                <div class="col mr-2">
                                    <div class="text-xs font-weight-bold text-info text-uppercase mb-1">
                                        Total Trips</div>
                                    <div class="h5 mb-0 font-weight-bold text-gray-800">@ViewBag.TotalTrips</div>
                                </div>
                                <div class="col-auto">
                                    <i class="fas fa-route fa-2x text-gray-300"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        @if (Model != null)
        {
            <div class="card border-left-success shadow h-100 py-2 mb-4 rounded-lg">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-success text-uppercase mb-1">
                                Active Trip (ID: @Model.Id)
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">
                                @Model.RouteStart <i class="fas fa-arrow-right mx-2 text-muted"></i> @Model.RouteEnd
                            </div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-route fa-2x text-gray-300"></i>
                        </div>
                    </div>
                    
                    <hr class="my-3" />
                    
                    <a asp-controller="LiveTracking" asp-action="Driver" asp-route-tripId="@Model.Id" class="btn btn-success btn-lg btn-block shadow-sm">
                        <i class="fas fa-satellite-dish mr-2"></i> Open GPS Tracker
                    </a>
                </div>
            </div>
        }
        else
        {
            <div class="card border-left-secondary shadow h-100 py-2 mb-4 rounded-lg">
                <div class="card-body text-center py-4">
                    <i class="fas fa-bed fa-3x text-gray-300 mb-3"></i>
                    <h5 class="font-weight-bold text-gray-600">No Active Trips</h5>
                    <p class="text-muted mb-0">You currently do not have any active trips assigned in the system.</p>
                </div>
            </div>
        }

        <div class="card border-left-warning shadow h-100 py-2 mb-4 rounded-lg">
            <div class="card-body">
                <div class="row no-gutters align-items-center mb-3">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">
                            Support & Alerts
                        </div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800">
                            Report an Issue
                        </div>
                    </div>
                    <div class="col-auto">
                        <i class="fas fa-exclamation-circle fa-2x text-gray-300"></i>
                    </div>
                </div>
                
                <p class="text-muted small">Need money for tolls? Break down? Send a message to the owner instantly.</p>

                <a asp-controller="DriverPortal" asp-action="CreateAlert" class="btn btn-warning btn-lg btn-block shadow-sm text-dark font-weight-bold">
                    <i class="fas fa-paper-plane mr-2"></i> Send Alert
                </a>
            </div>
        </div>

        <div class="card border-left-info shadow h-100 py-2 mb-4 rounded-lg">
            <div class="card-body">
                <div class="row no-gutters align-items-center mb-3">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-info text-uppercase mb-1">
                            Safety Compliance
                        </div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800">
                            Daily Vehicle Inspection (DVIR)
                        </div>
                    </div>
                    <div class="col-auto">
                        <i class="fas fa-clipboard-check fa-2x text-gray-300"></i>
                    </div>
                </div>
                
                <p class="text-muted small">Perform and submit your mandatory Pre-Trip / Post-Trip vehicle safety checklist before hitting the road.</p>

                <a asp-controller="VehicleInspections" asp-action="Create" class="btn btn-info btn-lg btn-block shadow-sm text-white font-weight-bold">
                    <i class="fas fa-clipboard-check mr-2"></i> Start Inspection Checklist
                </a>
            </div>
        </div>

    </div>
</div>

