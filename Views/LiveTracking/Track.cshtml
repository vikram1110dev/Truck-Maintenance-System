@model Truck_Maintanance_system.Models.TripRecord

@{
    ViewData["Title"] = "Live Map Tracking";
}

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<style>
    #map { height: 600px; width: 100%; border-radius: 0.5rem; }
    .status-pulse {
        display: inline-block;
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background-color: #28a745;
        box-shadow: 0 0 0 0 rgba(40, 167, 69, 1);
        animation: pulseMap 2s infinite;
        margin-right: 8px;
    }
    @keyframes pulseMap {
        0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(40, 167, 69, 0.7); }
        70% { transform: scale(1); box-shadow: 0 0 0 10px rgba(40, 167, 69, 0); }
        100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(40, 167, 69, 0); }
    }
</style>

<div class="container-fluid mt-3 mb-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="h4 text-gray-800 m-0">
            <i class="fas fa-map-marked-alt text-primary mr-2"></i> Live Tracking: @Model.Truck?.LicensePlate
        </h2>
        <div>
            <span class="badge badge-light border shadow-sm px-3 py-2 text-dark">
                <span class="status-pulse" id="statusPulse" style="background-color: #6c757d;"></span> 
                <span id="statusText">Waiting for signal...</span>
            </span>
            <a asp-controller="Trips" asp-action="Index" class="btn btn-outline-secondary btn-sm ml-3"><i class="fas fa-arrow-left"></i> Back to Trips</a>
        </div>
    </div>
    
    <p class="text-muted mb-3">Trip: @Model.RouteStart <i class="fas fa-arrow-right mx-1"></i> @Model.RouteEnd</p>

    <div class="card shadow border-0">
        <div class="card-body p-1">
            <div id="map"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
        const tripId = @Model.Id;
        
        // Initialize map centered on India
        const map = L.map('map').setView([20.5937, 78.9629], 5);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            maxZoom: 19,
            attribution: '© OpenStreetMap contributors'
        }).addTo(map);

        // Custom truck icon
        const truckIcon = L.divIcon({
            html: '<i class="fas fa-truck fa-2x text-primary" style="text-shadow: 0 2px 4px rgba(0,0,0,0.3);"></i>',
            iconSize: [30, 30],
            className: 'custom-div-icon'
        });

        let marker = null;
        let lastTimestamp = "";

        function fetchLocation() {
            fetch(`/LiveTracking/GetLatestLocation?tripId=${tripId}`)
                .then(response => {
                    if(!response.ok) throw new Error("No data");
                    return response.json();
                })
                .then(data => {
                    const latlng = [data.lat, data.lng];
                    
                    if (!marker) {
                        marker = L.marker(latlng, {icon: truckIcon}).addTo(map);
                        map.setView(latlng, 14); // Zoom in on first locate
                    } else {
                        marker.setLatLng(latlng);
                        map.panTo(latlng); // Smooth pan to new location
                    }
                    
                    marker.bindPopup(`<b>${data.timestamp}</b><br>Lat: ${data.lat.toFixed(4)}, Lng: ${data.lng.toFixed(4)}`).openPopup();

                    document.getElementById('statusPulse').style.backgroundColor = '#28a745';
                    document.getElementById('statusText').innerText = `Last ping: ${data.timestamp}`;
                    lastTimestamp = data.timestamp;
                })
                .catch(err => {
                    console.log("Waiting for data...");
                });
        }

        // Fetch immediately, then every 5 seconds
        fetchLocation();
        setInterval(fetchLocation, 5000);
    </script>
}
