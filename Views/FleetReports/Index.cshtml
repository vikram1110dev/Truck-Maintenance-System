@{
    ViewData["Title"] = "Fleet Reports & Export Center";
    var fromDate = ViewBag.FromDate as string;
    var toDate = ViewBag.ToDate as string;
    decimal revenue = (decimal)(ViewBag.TotalRevenue ?? 0);
    decimal maintenance = (decimal)(ViewBag.TotalMaintenanceCost ?? 0);
    decimal fuel = (decimal)(ViewBag.TotalFuelCost ?? 0);
    decimal netMargin = (decimal)(ViewBag.NetMargin ?? 0);
}

<div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="h3 font-weight-bold text-gray-800 mb-1">
                <i class="fas fa-file-export text-primary mr-2"></i> Fleet Reports & Export Center
            </h2>
            <p class="text-muted small mb-0">Generate, analyze, and export comprehensive audit spreadsheets in standard CSV / Excel format.</p>
        </div>
    </div>

    <!-- Date Filter Bar -->
    <div class="card shadow-sm mb-4">
        <div class="card-body py-3">
            <form method="get" class="row align-items-end g-3">
                <div class="col-md-4">
                    <label class="small font-weight-bold mb-1 text-muted"><i class="fas fa-calendar mr-1"></i> From Date</label>
                    <input type="date" name="fromDate" value="@fromDate" class="form-control form-control-sm" />
                </div>
                <div class="col-md-4">
                    <label class="small font-weight-bold mb-1 text-muted"><i class="fas fa-calendar mr-1"></i> To Date</label>
                    <input type="date" name="toDate" value="@toDate" class="form-control form-control-sm" />
                </div>
                <div class="col-md-4 d-flex gap-2">
                    <button type="submit" class="btn btn-primary btn-sm rounded-pill px-4">
                        <i class="fas fa-sync-alt mr-1"></i> Update Period
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                        Last 30 Days
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Financial Period Breakdown Cards -->
    <div class="row mb-4">
        <div class="col-xl-3 col-md-6 mb-3">
            <div class="card border-left-success shadow-sm h-100 py-2">
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-success text-uppercase mb-1">Trip Revenue</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">₹@revenue.ToString("N2")</div>
                            <small class="text-muted">@ViewBag.TotalTrips Trips logged</small>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-wallet fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-3">
            <div class="card border-left-danger shadow-sm h-100 py-2">
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-danger text-uppercase mb-1">Maintenance Expense</div>
                            <div class="h5 mb-0 font-weight-bold text-danger">₹@maintenance.ToString("N2")</div>
                            <small class="text-muted">Parts + Labor costs</small>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-tools fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-3">
            <div class="card border-left-warning shadow-sm h-100 py-2">
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">Fuel Spend</div>
                            <div class="h5 mb-0 font-weight-bold text-warning">₹@fuel.ToString("N2")</div>
                            <small class="text-muted">Fuel receipts & logs</small>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-gas-pump fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-3">
            <div class="card border-left-primary shadow-sm h-100 py-2">
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">Net Operating Margin</div>
                            <div class="h5 mb-0 font-weight-bold @(netMargin >= 0 ? "text-success" : "text-danger")">
                                ₹@netMargin.ToString("N2")
                            </div>
                            <small class="text-muted">Revenue &minus; (Maint + Fuel)</small>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-chart-pie fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Export Dataset Cards Grid -->
    <h5 class="font-weight-bold text-gray-800 mb-3"><i class="fas fa-download text-primary mr-2"></i> Download Audit & Report CSVs</h5>
    <div class="row">
        <!-- 1. Trips Export -->
        <div class="col-lg-6 mb-4">
            <div class="card shadow-sm h-100 border-0">
                <div class="card-body p-4 d-flex flex-column justify-content-between">
                    <div>
                        <div class="d-flex align-items-center mb-3">
                            <div class="bg-success text-white rounded p-3 mr-3 shadow-sm">
                                <i class="fas fa-route fa-2x"></i>
                            </div>
                            <div>
                                <h5 class="font-weight-bold mb-1">Trips & Freight Revenue Report</h5>
                                <p class="text-muted small mb-0">Includes Trip Dates, Vehicle Plates, Drivers, Distance (km), Fuel Cost, and Total Revenue.</p>
                            </div>
                        </div>
                    </div>
                    <div class="mt-3 pt-3 border-top d-flex justify-content-between align-items-center">
                        <span class="badge badge-light border"><i class="fas fa-file-csv text-success mr-1"></i> UTF-8 CSV</span>
                        <a asp-action="ExportTripsCsv" asp-route-fromDate="@fromDate" asp-route-toDate="@toDate" class="btn btn-success btn-sm rounded-pill px-4 shadow-sm">
                            <i class="fas fa-file-download mr-1"></i> Export Trips CSV
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- 2. Maintenance Export -->
        <div class="col-lg-6 mb-4">
            <div class="card shadow-sm h-100 border-0">
                <div class="card-body p-4 d-flex flex-column justify-content-between">
                    <div>
                        <div class="d-flex align-items-center mb-3">
                            <div class="bg-danger text-white rounded p-3 mr-3 shadow-sm">
                                <i class="fas fa-tools fa-2x"></i>
                            </div>
                            <div>
                                <h5 class="font-weight-bold mb-1">Mechanical Maintenance & Repairs</h5>
                                <p class="text-muted small mb-0">Detailed breakdown of parts cost, labor cost, preventative vs corrective services, and odometers.</p>
                            </div>
                        </div>
                    </div>
                    <div class="mt-3 pt-3 border-top d-flex justify-content-between align-items-center">
                        <span class="badge badge-light border"><i class="fas fa-file-csv text-danger mr-1"></i> UTF-8 CSV</span>
                        <a asp-action="ExportMaintenanceCsv" asp-route-fromDate="@fromDate" asp-route-toDate="@toDate" class="btn btn-danger btn-sm rounded-pill px-4 shadow-sm">
                            <i class="fas fa-file-download mr-1"></i> Export Maintenance CSV
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- 3. Fuel Logs Export -->
        <div class="col-lg-6 mb-4">
            <div class="card shadow-sm h-100 border-0">
                <div class="card-body p-4 d-flex flex-column justify-content-between">
                    <div>
                        <div class="d-flex align-items-center mb-3">
                            <div class="bg-warning text-dark rounded p-3 mr-3 shadow-sm">
                                <i class="fas fa-gas-pump fa-2x"></i>
                            </div>
                            <div>
                                <h5 class="font-weight-bold mb-1">Fuel Consumption & Receipts Log</h5>
                                <p class="text-muted small mb-0">Full record of fuel refills, volume (Liters), price rates, fuel stations, drivers, and payment modes.</p>
                            </div>
                        </div>
                    </div>
                    <div class="mt-3 pt-3 border-top d-flex justify-content-between align-items-center">
                        <span class="badge badge-light border"><i class="fas fa-file-csv text-warning mr-1"></i> UTF-8 CSV</span>
                        <a asp-action="ExportFuelLogsCsv" asp-route-fromDate="@fromDate" asp-route-toDate="@toDate" class="btn btn-warning btn-sm rounded-pill px-4 shadow-sm text-dark font-weight-bold">
                            <i class="fas fa-file-download mr-1"></i> Export Fuel CSV
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- 4. Safety Inspections Export -->
        <div class="col-lg-6 mb-4">
            <div class="card shadow-sm h-100 border-0">
                <div class="card-body p-4 d-flex flex-column justify-content-between">
                    <div>
                        <div class="d-flex align-items-center mb-3">
                            <div class="bg-info text-white rounded p-3 mr-3 shadow-sm">
                                <i class="fas fa-clipboard-check fa-2x"></i>
                            </div>
                            <div>
                                <h5 class="font-weight-bold mb-1">DVIR Vehicle Safety Audits</h5>
                                <p class="text-muted small mb-0">Audit history of Pre-trip & Post-trip inspection checklists, pass/fail results, and reported defects.</p>
                            </div>
                        </div>
                    </div>
                    <div class="mt-3 pt-3 border-top d-flex justify-content-between align-items-center">
                        <span class="badge badge-light border"><i class="fas fa-file-csv text-info mr-1"></i> UTF-8 CSV</span>
                        <a asp-action="ExportInspectionsCsv" asp-route-fromDate="@fromDate" asp-route-toDate="@toDate" class="btn btn-info btn-sm rounded-pill px-4 shadow-sm text-white font-weight-bold">
                            <i class="fas fa-file-download mr-1"></i> Export Safety Audits CSV
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
