<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Truck_Maintanance_system</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Truck_Maintanance_system.styles.css" asp-append-version="true" />
    <!-- FontAwesome for icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand font-weight-bold text-primary" asp-area="" asp-controller="Home" asp-action="Index"><i class="fas fa-truck"></i> TMS</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark font-weight-bold" asp-area="" asp-controller="Dashboard" asp-action="Index">
                                    <i class="fas fa-tachometer-alt text-primary"></i> Dashboard
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark font-weight-bold" asp-area="" asp-controller="Trucks" asp-action="Index">
                                    <i class="fas fa-truck"></i> Fleet
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="MechanicalMaintenance" asp-action="Create">
                                    <i class="fas fa-tools"></i> Log Maintenance
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="TruckDocuments" asp-action="Index">
                                    <i class="fas fa-folder-open"></i> Documents
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="AlertTickets" asp-action="Index">
                                    <i class="fas fa-exclamation-triangle text-danger"></i> Alerts
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Trips" asp-action="Index">
                                    <i class="fas fa-route"></i> Trips
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="FuelLogs" asp-action="Index">
                                    <i class="fas fa-gas-pump text-warning"></i> Fuel Logs
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="TyreInventory" asp-action="Index">
                                    <i class="fas fa-circle-notch text-secondary"></i> Tyres
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="VehicleInspections" asp-action="Index">
                                    <i class="fas fa-clipboard-check text-info"></i> Inspections
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="ServiceReminders" asp-action="Index">
                                    <i class="fas fa-calendar-check text-primary"></i> Service Reminders
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="SpareParts" asp-action="Index">
                                    <i class="fas fa-boxes text-warning"></i> Spare Parts
                                </a>
                            </li>


                            <li class="nav-item border-left ml-2 pl-2">
                                <a class="nav-link font-weight-bold text-success" asp-area="" asp-controller="ProfitReports" asp-action="Index">
                                    <i class="fas fa-chart-line"></i> Profit Dashboard
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link font-weight-bold text-info" asp-area="" asp-controller="Payroll" asp-action="Index">
                                    <i class="fas fa-hand-holding-usd"></i> Payroll
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link font-weight-bold text-warning" asp-area="" asp-controller="DriverPerformance" asp-action="Index">
                                    <i class="fas fa-medal"></i> Driver Scorecards
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link font-weight-bold text-primary" asp-area="" asp-controller="FleetReports" asp-action="Index">
                                    <i class="fas fa-file-export"></i> Reports Center
                                </a>
                            </li>


                        }
                    </ul>
                    
                    <ul class="navbar-nav">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item border-right mr-3 pr-3 d-flex align-items-center">
                                <span class="text-muted small">
                                    <i class="fas fa-user-circle"></i> @User.Identity.Name
                                </span>
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="form-inline">
                                    <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3 shadow-sm">
                                        <i class="fas fa-sign-out-alt"></i> Logout
                                    </button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="btn btn-primary btn-sm rounded-pill px-4 shadow-sm" asp-controller="Account" asp-action="Login">
                                    <i class="fas fa-sign-in-alt"></i> Login
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Truck_Maintanance_system - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
